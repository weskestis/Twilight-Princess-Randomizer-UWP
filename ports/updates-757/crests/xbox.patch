 }
 
+#elif defined(_WIN32) && defined(_UWP)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+// The Xbox port is linked into the game executable. The linker supplies its base.
+extern "C" IMAGE_DOS_HEADER __ImageBase;
+
+void crash_guard_init() {}
+
+bool coop_in_game_image(const void* address) {
+    const auto* base = reinterpret_cast<const unsigned char*>(&__ImageBase);
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(base + __ImageBase.e_lfanew);
+    const auto image = reinterpret_cast<uintptr_t>(base);
+    const auto value = reinterpret_cast<uintptr_t>(address);
+    return value >= image && value - image < nt->OptionalHeader.SizeOfImage;
+}
+
 #else
 
 void crash_guard_init() {}
