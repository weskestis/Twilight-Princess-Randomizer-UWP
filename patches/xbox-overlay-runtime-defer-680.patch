+    if (deferInitialXboxSync) {
+        deferInitialXboxSync = false;
+        if (files.empty()) {
+            Log.debug("No overlay files; skipping initial Xbox overlay registration.");
+            return;
+        }
+        deferredXboxFiles = true;
+        s_overlaysDirty = true;
+        Log.debug("Deferring {} DVD overlay file(s) until the Xbox runtime frame.", files.size());
