+// Called only by the host companion service on the game/UI thread, at most 2 Hz.
+// A catalog is built once per active seed, without fill or reachability searches.
+// Snapshot values are copied; no engine pointers are handed to the network worker.
+extern "C" const char* tpr_companion_snapshot() noexcept {
+    using Json = nlohmann::ordered_json;
+    using Clock = std::chrono::steady_clock;
+    static std::unique_ptr<randomizer::Randomizer> rando;
+    static std::string hash, encoded = "{\"state\":\"inactive\",\"save\":null}";
+    static uint64_t revision = 0;
+    static Clock::time_point readyAt{}, retryAt{};
+    static bool wasSafe = false;
+    try {
+        auto inactive = [&](const char* state) {
+            encoded = Json{{"state", state}, {"save", nullptr}}.dump();
+            wasSafe = false;
+            return encoded.c_str();
+        };
+        if (!randomizer::session::g_seedActivated || !randomizer_IsActive()) {
+            rando.reset(); hash.clear(); return inactive("inactive");
+        }
+        auto& context = randomizer_GetContext();
+        if (context.mCreatingSave || !g_randomizerState.mInitialized ||
+            g_randomizerState.getRoomReloadingState() || dComIfGp_getPlayer(0) == nullptr ||
+            getStageID() == Title_Screen || randomizer::session::currentSaveSlot() < 0 ||
+            context.mHash.empty()) return inactive("loading");
+        const auto currentRevision = randomizer::session::saveStateRevision();
+        if (hash != context.mHash || revision != currentRevision) {
+            if (hash != context.mHash) rando.reset();
+            hash = context.mHash; revision = currentRevision; wasSafe = false; retryAt = {};
+        }
+        const auto now = Clock::now();
+        if (!wasSafe) { readyAt = now + std::chrono::seconds(3); wasSafe = true; }
+        if (now < readyAt || dComIfGp_event_runCheck()) {
+            encoded = Json{{"state", "loading"}, {"save", nullptr}}.dump(); return encoded.c_str();
+        }
+        if (!rando) {
+            if (now < retryAt) { encoded = "{\"state\":\"tracker_unavailable\",\"save\":null}"; return encoded.c_str(); }
+            retryAt = now + std::chrono::seconds(30);
+            auto prepared = std::make_unique<randomizer::Randomizer>(randomizer::paths::GetRandomizerPath());
+            prepared->GenerateTrackerWorld(false);
+            if (!prepared->GetWorld()) throw std::runtime_error("Tracker world missing");
+            rando = std::move(prepared);
+        }
+        auto* world = rando->GetWorld();
+        auto checks = world->GetAllLocations();
+        std::sort(checks.begin(), checks.end(), [](auto* a, auto* b) { return a->GetID() < b->GetID(); });
+        Json checkList = Json::array(), entranceList = Json::array(), dungeonList = Json::array(), inventoryList = Json::array();
+        for (auto* check : checks) {
+            std::vector<std::string> categories(check->GetCategories().begin(), check->GetCategories().end());
+            std::sort(categories.begin(), categories.end());
+            const bool collected = isLocationObtained(check);
+            checkList.push_back({{"id", check->GetID()}, {"name", check->GetName()}, {"categories", categories},
+                {"randomized", context.mItemLocations.contains(check->GetName())}, {"collected", collected},
+                {"seen", collected || randomizer_IsLocationSeen(static_cast<u32>(check->GetID()))}});
+        }
+        // Only the discovered log is used. Neither placements nor hidden entrance
+        // destinations, barren/required hints or uncollected item IDs enter JSON.
+        for (const auto& entrance : randomizer_GetDiscoveredEntranceLog())
+            entranceList.push_back({{"source", entrance.source}, {"destination", entrance.destination},
+                {"category", entrance.category}, {"sourceStage", entrance.sourceStage}, {"destinationStage", entrance.destinationStage}});
+        const auto owned = getSaveItemPool(world);
+        std::map<std::string, std::pair<int, int>> counts;
+        for (auto* item : owned) if (item) { auto& entry = counts[item->GetName()]; entry.first = item->GetID(); ++entry.second; }
+        for (const auto& [name, item] : counts) inventoryList.push_back({{"id", item.first}, {"name", name}, {"count", item.second}});
+        auto countItem = [&](auto* item) { return item ? static_cast<int>(std::count(owned.begin(), owned.end(), item)) : 0; };
+        for (const auto& [name, dungeon] : world->GetDungeonTable())
+            dungeonList.push_back({{"name", name}, {"smallKeysFound", countItem(dungeon->GetSmallKey())},
+                {"bigKey", countItem(dungeon->GetBigKey()) > 0}, {"map", countItem(dungeon->GetDungeonMap()) > 0},
+                {"compass", countItem(dungeon->GetCompass()) > 0},
+                {"completed", dungeon->GetGoalLocation() && isLocationObtained(dungeon->GetGoalLocation())}});
+        Json settings = Json::object();
+        for (const auto& [name, setting] : rando->GetConfig().GetSettings().GetMap()) settings[name] = setting.GetCurrentOption();
+        encoded = Json{{"state", "playing"}, {"save", {{"seedHash", context.mHash}, {"seedId", context.mSeedID},
+            {"slot", randomizer::session::currentSaveSlot()}, {"revision", currentRevision},
+            {"stage", getStageID()}, {"gameTimeCentiseconds", randomizer_GetActiveGameTimeCentiseconds()},
+            {"deaths", dComIfGs_getDeathCount()}, {"settings", settings}, {"checks", checkList},
+            {"inventory", inventoryList}, {"entrances", entranceList}, {"entranceTotal", randomizer_GetEntranceLogTotal()},
+            {"dungeons", dungeonList}}}}.dump();
+    } catch (...) { encoded = "{\"state\":\"tracker_unavailable\",\"save\":null}"; }
+    return encoded.c_str();
+}
 #endif
