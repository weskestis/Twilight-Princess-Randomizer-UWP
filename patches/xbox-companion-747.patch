+#include "bridge.hpp"
+#include <array>
+#include "d/d_com_inf_game.h"
+
+extern "C" bool dusk_companion_random(void*, size_t) noexcept;
+extern "C" size_t dusk_companion_addresses(char*, size_t) noexcept;
+extern "C" const char* tpr_companion_snapshot() noexcept;
+
+namespace dusk::companion {
+Server& server() {
+    static Server value(
+        [](std::span<std::byte> bytes) { return dusk_companion_random(bytes.data(), bytes.size()); },
+        [] {
+            auto state = Json::parse(tpr_companion_snapshot(), nullptr, false);
+            if (!state.is_object()) state = {{"state", "unavailable"}, {"save", nullptr}};
+            if (state.value("state", "") == "inactive")
+                state["state"] = dComIfGp_getPlayer(0) != nullptr ? "vanilla" : "launcher";
+            return state;
+        });
+    return value;
+}
+void initialize() noexcept {} // Explicit Xbox UI action is the only way to listen.
+void shutdown() noexcept { try { server().disable(); } catch (...) {} }
+void update() noexcept { try { server().update(); } catch (...) {} }
+std::vector<std::string> addresses() {
+    std::array<char, 1024> buffer{};
+    dusk_companion_addresses(buffer.data(), buffer.size());
+    std::vector<std::string> result;
+    std::string_view remaining(buffer.data());
+    while (!remaining.empty()) {
+        const auto end = remaining.find('\n');
+        auto ip = remaining.substr(0, end);
+        if (Server::private_peer("tcp://" + std::string(ip) + ":18473") && !ip.starts_with("127."))
+            result.emplace_back(ip);
+        if (end == std::string_view::npos) break;
+        remaining.remove_prefix(end + 1);
+    }
+    return result;
+}
+}
