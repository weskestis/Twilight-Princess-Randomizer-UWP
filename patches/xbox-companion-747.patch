+extern "C" size_t dusk_companion_addresses(char* buffer, size_t capacity) noexcept {
+    if (!buffer || capacity == 0) return 0;
+    buffer[0] = 0;
+    try {
+        // Direct SDK ABI keeps this Store executable free of projection fallback
+        // LoadLibrary imports, just like the existing Xbox memory probe.
+        Microsoft::WRL::ComPtr<ABI::Windows::Networking::Connectivity::INetworkInformationStatics> info;
+        Microsoft::WRL::Wrappers::HStringReference name(RuntimeClass_Windows_Networking_Connectivity_NetworkInformation);
+        if (FAILED(RoGetActivationFactory(name.Get(), IID_PPV_ARGS(info.GetAddressOf())))) return 0;
+        Microsoft::WRL::ComPtr<ABI::Windows::Foundation::Collections::IVectorView<ABI::Windows::Networking::HostName*>> hosts;
+        if (FAILED(info->GetHostNames(hosts.GetAddressOf()))) return 0;
+        unsigned count = 0; if (FAILED(hosts->get_Size(&count))) return 0;
+        std::string result;
+        for (unsigned i = 0; i < count && i < 64; ++i) {
+            Microsoft::WRL::ComPtr<ABI::Windows::Networking::IHostName> host;
+            ABI::Windows::Networking::HostNameType type{};
+            if (FAILED(hosts->GetAt(i, host.GetAddressOf())) || FAILED(host->get_Type(&type)) ||
+                type != ABI::Windows::Networking::HostNameType_Ipv4) continue;
+            Microsoft::WRL::ComPtr<ABI::Windows::Networking::Connectivity::IIPInformation> ip;
+            if (FAILED(host->get_IPInformation(ip.GetAddressOf())) || !ip) continue;
+            Microsoft::WRL::Wrappers::HString value;
+            if (FAILED(host->get_CanonicalName(value.GetAddressOf()))) continue;
+            UINT32 length = 0; const auto* wide = WindowsGetStringRawBuffer(value.Get(), &length);
+            if (!wide || length == 0 || length > 15) continue;
+            std::string address; bool valid = true;
+            for (UINT32 j = 0; j < length; ++j) {
+                if ((wide[j] < L'0' || wide[j] > L'9') && wide[j] != L'.') { valid = false; break; }
+                address += static_cast<char>(wide[j]);
+            }
+            if (valid && result.size() + address.size() + 2 <= capacity) result += address + "\n";
+        }
+        std::memcpy(buffer, result.c_str(), result.size() + 1); return result.size();
+    } catch (...) { return 0; }
+}
