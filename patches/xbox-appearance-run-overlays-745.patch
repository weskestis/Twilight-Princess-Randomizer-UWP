diff --git a/mods/cosmetics/src/appearance_runtime.hpp b/mods/cosmetics/src/appearance_runtime.hpp
new file mode 100644
index 0000000..18ccfc3
--- /dev/null
+++ b/mods/cosmetics/src/appearance_runtime.hpp
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <random>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Port of the pre-2.0 scene palette rules. These values override getters only;
+// scene rolls must never overwrite the user's saved individual color choices.
+namespace dusk_xbox_appearance {
+enum class Mode : unsigned { Manual, Seed, Load, Rainbow };
+struct Target { std::uint64_t handle; std::string_view name; bool integer = false; };
+struct Color { unsigned r, g, b; };
+inline constexpr std::array<Color, 8> RainbowAnchors{{
+    {255, 0, 0}, {255, 128, 0}, {255, 255, 0}, {0, 255, 0},
+    {0, 255, 255}, {0, 0, 255}, {128, 0, 255}, {255, 0, 255}}};
+inline constexpr std::array<std::array<std::string_view, 3>, 8> HeartPalettes{{
+    {{"e53935", "f45151", "c62828"}}, {{"f57c00", "ff9800", "ef6c00"}},
+    {{"f9c80e", "fdd835", "d4ac0d"}}, {{"43a047", "66bb6a", "2e7d32"}},
+    {{"00acc1", "26c6da", "00838f"}}, {{"1e88e5", "42a5f5", "1565c0"}},
+    {{"8e24aa", "ab47bc", "6a1b9a"}}, {{"d81b60", "ec407a", "ad1457"}}}};
+
+inline std::uint64_t stable_hash(std::string_view seed, std::string_view name) noexcept {
+    std::uint64_t value = 1469598103934665603ULL;
+    for (unsigned char byte : seed) { value ^= byte; value *= 1099511628211ULL; }
+    value ^= 0xff; value *= 1099511628211ULL;
+    for (unsigned char byte : name) { value ^= byte; value *= 1099511628211ULL; }
+    value ^= value >> 30; value *= 0xbf58476d1ce4e5b9ULL;
+    value ^= value >> 27; value *= 0x94d049bb133111ebULL;
+    return value ^ (value >> 31);
+}
+inline std::string hex(Color color) {
+    constexpr char digits[] = "0123456789abcdef";
+    std::string result(6, '0');
+    const std::array<unsigned, 3> channels{{color.r, color.g, color.b}};
+    for (unsigned i = 0; i < 3; ++i) {
+        result[i * 2] = digits[channels[i] >> 4];
+        result[i * 2 + 1] = digits[channels[i] & 15];
+    }
+    return result;
+}
+inline std::string rainbow(std::uint64_t milliseconds, int speed) {
+    constexpr std::array<std::uint64_t, 3> segments{{4000, 2000, 1000}};
+    const auto duration = segments[std::clamp(speed, 0, 2)];
+    const auto first = (milliseconds / duration) % RainbowAnchors.size();
+    const auto next = (first + 1) % RainbowAnchors.size();
+    const auto t = milliseconds % duration;
+    const auto blend = [t, duration](unsigned a, unsigned b) {
+        return static_cast<unsigned>((a * (duration - t) + b * t + duration / 2) / duration);
+    };
+    return hex({blend(RainbowAnchors[first].r, RainbowAnchors[next].r),
+                blend(RainbowAnchors[first].g, RainbowAnchors[next].g),
+                blend(RainbowAnchors[first].b, RainbowAnchors[next].b)});
+}
+
+class Runtime {
+    struct Value { Target target; std::string text; std::int64_t number = 0; bool rainbow = false; };
+    std::vector<Value> values_;
+    Mode mode_ = Mode::Manual;
+    std::uint64_t revision_ = 0;
+    std::string seed_;
+    std::size_t heartFamily_ = HeartPalettes.size();
+    bool heartRainbow_ = false;
+public:
+    void clear() { *this = Runtime{}; }
+    void sync(const std::vector<Target>& targets, Mode mode, std::uint64_t revision,
+              std::string_view seed, std::uint64_t milliseconds, int speed) {
+        if (mode == Mode::Manual || (mode == Mode::Seed && seed.empty())) {
+            clear(); return;
+        }
+        const bool roll = mode != mode_ || (mode == Mode::Seed && seed != seed_) ||
+                          (mode == Mode::Load && revision != revision_) || values_.empty();
+        if (roll) {
+            if (mode != mode_) { heartFamily_ = HeartPalettes.size(); heartRainbow_ = false; }
+            values_.clear(); values_.reserve(targets.size());
+            std::mt19937_64 rng(stable_hash(std::to_string(revision), "load-scene-appearance"));
+            for (const auto target : targets) {
+                const auto random = mode == Mode::Seed ? stable_hash(seed, std::string("cosmetics.") + std::string(target.name)) : rng();
+                Value value{target};
+                value.rainbow = mode == Mode::Rainbow || random % 8 == 0;
+                if (target.name == "heartColor" && mode == Mode::Load) {
+                    value.rainbow = value.rainbow && !heartRainbow_;
+                    heartRainbow_ = value.rainbow;
+                    if (!value.rainbow) {
+                        std::array<std::size_t, 8> candidates{}; std::size_t count = 0;
+                        for (std::size_t i = 0; i < HeartPalettes.size(); ++i) {
+                            const auto distance = i > heartFamily_ ? i - heartFamily_ : heartFamily_ - i;
+                            if (heartFamily_ == HeartPalettes.size() || std::min(distance, 8 - distance) >= 2)
+                                candidates[count++] = i;
+                        }
+                        std::uniform_int_distribution<std::size_t> family(0, count - 1), shade(0, 2);
+                        heartFamily_ = candidates[family(rng)];
+                        value.text = HeartPalettes[heartFamily_][shade(rng)];
+                    }
+                }
+                if (target.integer) value.number = static_cast<std::int64_t>((random / 8) % 9);
+                else if (value.text.empty()) value.text = hex({32u + unsigned(random & 255) % 224,
+                    32u + unsigned((random >> 8) & 255) % 224,
+                    32u + unsigned((random >> 16) & 255) % 224});
+                values_.push_back(std::move(value));
+            }
+            mode_ = mode; revision_ = revision; seed_ = seed;
+        }
+        for (auto& value : values_) if (value.rainbow) {
+            if (value.target.integer) {
+                // Midna's selected-color getter interpolates all nine authored RGB registers.
+                value.number = 2;
+            } else value.text = rainbow((milliseconds / 50) * 50, speed);
+        }
+    }
+    bool is_rainbow(std::uint64_t handle) const {
+        for (const auto& value : values_) if (handle != 0 && value.target.handle == handle) return value.rainbow;
+        return false;
+    }
+    const std::string* string(std::uint64_t handle) const {
+        for (const auto& value : values_)
+            if (handle != 0 && value.target.handle == handle && !value.target.integer) return &value.text;
+        return nullptr;
+    }
+    const std::int64_t* integer(std::uint64_t handle) const {
+        for (const auto& value : values_)
+            if (handle != 0 && value.target.handle == handle && value.target.integer) return &value.number;
+        return nullptr;
+    }
+};
+}
