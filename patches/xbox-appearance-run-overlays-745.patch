+GXColor xbox_blend_midna_color(const GXColor& a, const GXColor& b, uint64_t t, uint64_t duration) {
+    const auto channel = [t, duration](u8 from, u8 to) {
+        return static_cast<u8>((static_cast<uint64_t>(from) * (duration - t) +
+            static_cast<uint64_t>(to) * t + duration / 2) / duration);
+    };
+    return {channel(a.r,b.r),channel(a.g,b.g),channel(a.b,b.b),channel(a.a,b.a)};
+}
+GXColor xbox_selected_midna_color(ConfigVarHandle handle, size_t choice, size_t index) {
+#if defined(_UWP)
+    uint64_t milliseconds = 0, duration = 1;
+    if (get_xbox_midna_rainbow_phase(handle, milliseconds, duration)) {
+        constexpr std::array<size_t,8> anchors{{2,2,3,4,4,5,6,1}};
+        const auto color = [index, &anchors](size_t segment) {
+            segment %= 8;
+            if (segment == 1) return xbox_blend_midna_color(kMidnaHairColors[2][index],kMidnaHairColors[3][index],1,2);
+            if (segment == 4) return xbox_blend_midna_color(kMidnaHairColors[4][index],kMidnaHairColors[5][index],1,2);
+            return kMidnaHairColors[anchors[segment]][index];
+        };
+        const auto segment = milliseconds / duration;
+        return xbox_blend_midna_color(color(segment),color(segment+1),milliseconds % duration,duration);
+    }
+#endif
+    return kMidnaHairColors.at(choice)[index];
+}
