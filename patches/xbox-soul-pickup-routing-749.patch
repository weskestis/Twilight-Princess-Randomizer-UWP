+extern "C" u32 tpr_resolve_soul_pickup_for_actor(u8 physicalItemId, const fopAc_ac_c* itemActor) noexcept {
+    // Static UWP calls also run in vanilla play. Only consult randomizer
+    // bindings while this session owns the native Soul message entries.
+    if (!messages::soul_pickup_messages_active() || itemActor == nullptr ||
+        session::svc_mng.item == nullptr) return 0;
+    try {
+        return messages::pickup_message_id(getSoulItemMessageID(physicalItemId, itemActor));
+    } catch (...) {
+        // Leave ordinary native selection and pickup recovery available.
+        return 0;
+    }
+}
