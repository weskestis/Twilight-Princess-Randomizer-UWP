+            for (const auto& hint : list) {
+                std::string type;
+                if (std::holds_alternative<hints::PathHint>(hint.data)) type = "Path Hints";
+                else if (std::holds_alternative<hints::BarrenHint>(hint.data)) type = "Barren Hints";
+                else if (std::holds_alternative<hints::ItemHint>(hint.data)) type = "Item Hints";
+                else if (std::holds_alternative<hints::LocationHint>(hint.data)) type = "Location Hints";
+                if (type.empty()) continue;
+                const auto& destination = world->Setting(type + " on Hint Signs");
+                if ((destination == "Overworld" && sign->HasCategories("Dungeon")) ||
+                    (destination == "Dungeon" && sign->HasCategories("Overworld"))) {
+                    throw std::runtime_error("Max hint violated its sign destination setting");
+                }
+                if (std::find(uniqueHints.begin(), uniqueHints.end(), hint) == uniqueHints.end()) {
+                    uniqueHints.push_back(hint);
+                }
+            }
