+        for (const auto& hint : uniqueHints) {
+            location::Location* hintedLocation = nullptr;
+            if (auto* h = std::get_if<hints::PathHint>(&hint.data)) hintedLocation = h->hintedLocation;
+            if (auto* h = std::get_if<hints::ItemHint>(&hint.data)) hintedLocation = h->location;
+            if (auto* h = std::get_if<hints::LocationHint>(&hint.data)) hintedLocation = h->location;
+            if (!hintedLocation) continue;
+            const auto signs = search::GetPossibleHintSigns(hintedLocation);
+            bool hasReachableCopy = false;
+            for (auto* sign : signs) {
+                const auto& assigned = world->GetHintSignHints()[sign];
+                if (std::find(assigned.begin(), assigned.end(), hint) != assigned.end()) {
+                    hasReachableCopy = true;
+                    break;
+                }
+            }
+            if (!hasReachableCopy) {
+                throw std::runtime_error("Max hint has no copy reachable before its hinted item");
+            }
+        }
+    }
+    std::cout << "PASS: Max sign hint counts, configured destinations and item-before-hint access" << std::endl;
+}
