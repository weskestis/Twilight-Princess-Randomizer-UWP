diff --git a/src/dusk/mods/loader/natives.cpp b/src/dusk/mods/loader/natives.cpp
index 6b0e345..ba65d23 100644
--- a/src/dusk/mods/loader/natives.cpp
+++ b/src/dusk/mods/loader/natives.cpp
@@ -340,6 +340,43 @@ bool parse_meta(NativeMod& native, LoadedMod& mod) {
     return true;
 }
 
+#if defined(_UWP)
+constexpr std::string_view k_builtinRandomizerId = "dev.twilitrealm.randomizer"sv;
+
+bool load_builtin_randomizer(LoadedMod& mod, const fs::path& cacheDir) {
+    const fs::path scratchDir = cacheDir / mod.metadata.id / "data";
+    std::error_code ec;
+    fs::create_directories(scratchDir, ec);
+    if (ec) {
+        log::write(mod.metadata.id, LOG_LEVEL_ERROR,
+            "failed to create built-in mod directory {}: {}",
+            data::abbreviated_path_string(scratchDir), ec.message());
+        mod.nativeStatus = NativeModStatus::Unknown;
+        return false;
+    }
+
+    auto native = std::make_unique<NativeMod>();
+    native->meta = &mod_meta;
+    native->contextSymbol = &mod_ctx;
+    native->fn_initialize = &mod_initialize;
+    native->fn_update = &mod_update;
+    native->fn_shutdown = &mod_shutdown;
+    if (!parse_meta(*native, mod)) {
+        return false;
+    }
+    *native->contextSymbol = mod.context.get();
+
+    mod.dir = fs::absolute(scratchDir);
+    mod.dirUtf8 = borealis::io::fs_path_to_string(mod.dir);
+    mod.nativeDir = fs::absolute(mod.modPath);
+    mod.nativeDirUtf8 = borealis::io::fs_path_to_string(mod.nativeDir);
+    mod.native = std::move(native);
+    mod.nativeStatus = NativeModStatus::Loaded;
+    startup_guard::stage("native.ready:dev.twilitrealm.randomizer:built-in");
+    return true;
+}
+#endif
+
 std::string native_status_message(const NativeModStatus status) {
     switch (status) {
     case NativeModStatus::BuildDisabled:
@@ -535,6 +572,18 @@ void ModLoader::load_native(
 }
 
 bool ModLoader::load_native_if_present(LoadedMod& mod) {
+#if defined(_UWP)
+    // Never load a second Randomizer image on Xbox, including a stale user bundle
+    // that shadows the packaged data directory.
+    if (mod.metadata.id == k_builtinRandomizerId) {
+        mod.nativeStatus = NativeModStatus::Unknown;
+        if (!load_builtin_randomizer(mod, m_cacheDir)) {
+            fail_mod(mod, MOD_ERROR, native_status_message(mod.nativeStatus));
+            return false;
+        }
+        return true;
+    }
+#endif
     const auto result = locate_native_runtime(*mod.bundle);
     if (const auto* failure = std::get_if<NativeLocateFailure>(&result)) {
         mod.nativeStatus = failure->status;
@@ -569,6 +618,13 @@ void ModLoader::unload_native(LoadedMod& mod) {
     if (!mod.native) {
         return;
     }
+#if defined(_UWP)
+    if (mod.metadata.id == k_builtinRandomizerId && !mod.native->handle) {
+        // The built-in code lives in the main executable and cannot be unloaded.
+        // Keep its entry points attached so a settings-driven re-enable works.
+        return;
+    }
+#endif
     // Deferred dlclose: this mod's code may still be on the stack below the current tick
     m_retiredNatives.push_back(
         {std::move(mod.native), mod.nativeInPlace ? fs::path{} : std::move(mod.nativeDir)});
