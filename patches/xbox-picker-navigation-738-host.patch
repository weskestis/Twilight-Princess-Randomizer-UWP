+inline void add_shortcuts(Listing& listing, const std::vector<Entry>& shortcuts) {
+    // A child folder can be accessible even when its drive root cannot be listed.
+    // Keep named entry points visible and report access errors when opened.
+    std::vector<Entry> entries;
+    auto add = [&](Entry entry) {
+        if (entry.location.empty()) return;
+        entry.location = utf8(path(entry.location).lexically_normal());
+        if (std::any_of(entries.begin(), entries.end(), [&](const Entry& existing) {
+            return same_location(existing.location, entry.location);
+        })) return;
+        entries.push_back(std::move(entry));
+    };
+    for (const auto& entry : shortcuts) add(entry);
+    for (auto& entry : listing.entries) add(std::move(entry));
+    listing.entries = std::move(entries);
