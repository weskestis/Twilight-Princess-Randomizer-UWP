new file mode 100644
index 0000000..f2480aa
--- /dev/null
+++ b/src/dusk/ui/mod_panel_delay.hpp
@@ -0,0 +1,30 @@
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace dusk::ui {
+class ModPanelDelay {
+public:
+    using Clock = std::chrono::steady_clock;
+    void cancel() noexcept { mPending = false; }
+    void select(std::string_view id, uint64_t registry, uint64_t resource, Clock::time_point now) {
+        mId = id; mRegistry = registry; mResource = resource;
+        mDue = now + std::chrono::milliseconds(100); mPending = true;
+    }
+    bool take(std::string_view id, uint64_t registry, uint64_t resource, Clock::time_point now) {
+        if (!mPending) return false;
+        if (id != mId || registry != mRegistry || resource != mResource) {
+            cancel(); return false;
+        }
+        if (now < mDue) return false;
+        cancel(); return true;
+    }
+private:
+    std::string mId;
+    uint64_t mRegistry = 0, mResource = 0;
+    Clock::time_point mDue{};
+    bool mPending = false;
+};
+}
