diff --git a/tools/tests/test_enemy_soul_fill_priority.py b/tools/tests/test_enemy_soul_fill_priority.py
new file mode 100644
index 0000000000..c36a42833f
--- /dev/null
+++ b/tools/tests/test_enemy_soul_fill_priority.py
@@ -0,0 +1,103 @@
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+FILL_SOURCE = (
+    ROOT / "src" / "dusk" / "randomizer" / "generator" / "logic" / "fill.cpp"
+)
+ITEM_POOL_SOURCE = (
+    ROOT / "src" / "dusk" / "randomizer" / "generator" / "logic" / "item_pool.cpp"
+)
+
+
+class EnemySoulFillPriorityTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = FILL_SOURCE.read_text(encoding="utf-8")
+        cls.item_pool_source = ITEM_POOL_SOURCE.read_text(encoding="utf-8")
+
+    def test_twilight_quest_target_souls_are_safe_starting_permissions(self):
+        self.assertIn('world->Setting("Enemy Souls") == "On"', self.item_pool_source)
+        for item_name in (
+            "Faron Twilit Insect Soul",
+            "Eldin Twilit Insect Soul",
+            "Lanayru Twilit Insect Soul",
+            "Twilit Bloat Soul",
+        ):
+            self.assertIn(
+                f'startingItems["{item_name}"] = 1;',
+                self.item_pool_source,
+            )
+
+    def test_constrained_souls_are_removed_before_general_major_fill(self):
+        soul_extract = self.source.index("auto enemySoulItems")
+        soul_fill = self.source.index(
+            "AssumedFill(worlds, enemySoulItems, itemPool, enemySoulLocations,"
+        )
+        major_extract = self.source.index("auto majorItems")
+        major_fill = self.source.index(
+            "AssumedFill(worlds, majorItems, itemPool, progressLocations,"
+        )
+
+        self.assertLess(soul_extract, soul_fill)
+        self.assertLess(soul_fill, major_extract)
+        self.assertLess(major_extract, major_fill)
+
+    def test_soul_partition_uses_stable_extended_item_ids(self):
+        soul_extract = self.source.index("auto enemySoulItems")
+        major_extract = self.source.index("auto majorItems")
+        block = self.source[soul_extract:major_extract]
+
+        self.assertIn("FilterAndEraseFromVector(", block)
+        self.assertIn("is_enemy_soul(", block)
+        self.assertIn("static_cast<std::uint16_t>(item->GetID())", block)
+        self.assertIn(
+            "AssumedFill(worlds, enemySoulItems, itemPool, enemySoulLocations,",
+            block,
+        )
+
+    def test_souls_use_every_topology_safe_extended_item_check(self):
+        soul_extract = self.source.index("auto enemySoulItems")
+        major_extract = self.source.index("auto majorItems")
+        block = self.source[soul_extract:major_extract]
+
+        self.assertIn('categories.contains("Chest")', block)
+        self.assertIn('categories.contains("Freestanding Item")', block)
+        self.assertIn('categories.contains("Enemy First Defeat")', block)
+        self.assertNotIn('location->HasCategories("Enemy First Defeat")', block)
+        self.assertIn("location->IsEmpty()", block)
+        self.assertIn("enemySoulItems.size() > enemySoulLocations.size()", block)
+
+    def test_soul_fill_exhausts_alternative_items_before_retrying(self):
+        soul_extract = self.source.index("auto enemySoulItems")
+        major_extract = self.source.index("auto majorItems")
+        block = self.source[soul_extract:major_extract]
+
+        self.assertIn("-1, 250, true", block)
+        self.assertIn("tryEveryItemBeforeRetry && !itemsToPlace.empty()", self.source)
+        self.assertIn("deferredItems.push_back(itemToPlace)", self.source)
+        self.assertIn("assumedItems.end(), deferredItems.begin()", self.source)
+
+    def test_major_fill_keeps_exhaustive_continuations_after_soul_placement(self):
+        major_extract = self.source.index("auto majorItems")
+        minor_fill = self.source.index("// Place Minor items")
+        block = self.source[major_extract:minor_fill]
+
+        self.assertIn("AssumedFill(worlds, majorItems, itemPool, progressLocations", block)
+        self.assertIn("-1, 250, true", block)
+
+    def test_failed_major_fill_rerolls_the_constrained_soul_topology(self):
+        major_extract = self.source.index("auto majorItems")
+        minor_fill = self.source.index("// Place Minor items")
+        block = self.source[major_extract:minor_fill]
+
+        self.assertIn("kSoulMajorTopologyRetries = 25", block)
+        self.assertIn("catch (const AssumedFillFailure& error)", block)
+        self.assertIn("class AssumedFillFailure final", self.source)
+        self.assertIn("for (auto* location : enemySoulPlacements)", block)
+        self.assertIn("location->RemoveCurrentItem()", block)
+        self.assertIn("itemsAssumedForSoulPlacement", block)
+
+if __name__ == "__main__":
+    unittest.main()
