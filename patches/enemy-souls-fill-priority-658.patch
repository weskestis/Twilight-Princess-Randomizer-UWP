@@ -0,0 +1,125 @@
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+HINTS_SOURCE = (
+    ROOT / "src" / "dusk" / "randomizer" / "generator" / "logic" / "hints.cpp"
+)
+HINTS_HEADER = (
+    ROOT / "src" / "dusk" / "randomizer" / "generator" / "logic" / "hints.hpp"
+)
+HINT_TYPES_HEADER = (
+    ROOT / "src" / "dusk" / "randomizer" / "generator" / "logic" / "hint_types.hpp"
+)
+
+
+class HintSignAssignmentTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = HINTS_SOURCE.read_text(encoding="utf-8")
+        cls.header = HINTS_HEADER.read_text(encoding="utf-8")
+        cls.hint_types = HINT_TYPES_HEADER.read_text(encoding="utf-8")
+        start = cls.source.index("static void AssignHintSignHints")
+        end = cls.source.index("void HintGenerator::DistributeHints", start)
+        cls.assignment = cls.source[start:end]
+        item_start = cls.source.index("void HintGenerator::GenerateItemHints")
+        remote_start = cls.source.index("void HintGenerator::GenerateRemoteLocationHints")
+        location_start = cls.source.index("void HintGenerator::GenerateLocationHints")
+        availability_start = cls.source.index("HintGenerator::GetAvailableHintSigns")
+        cls.item_generation = cls.source[item_start:remote_start]
+        cls.remote_generation = cls.source[remote_start:location_start]
+        cls.location_generation = cls.source[location_start:availability_start]
+
+    def test_empty_hint_pool_is_checked_before_dividing_by_sign_count(self):
+        empty_check = self.assignment.index("if (hints.empty())")
+        sign_check = self.assignment.index("if (hintSigns.empty())")
+        division = self.assignment.index("size_t hintsPerSign")
+
+        self.assertLess(empty_check, sign_check)
+        self.assertLess(sign_check, division)
+
+    def test_logical_hint_placement_uses_capacity_aware_matching(self):
+        for marker in (
+            "availableSignsByHint",
+            "signSlots",
+            "assignedHintBySlot",
+            "tryAssignHint",
+            "visitedSlots",
+        ):
+            self.assertIn(marker, self.assignment)
+
+        self.assertNotIn("retryCount = 50", self.assignment)
+        self.assertNotIn("successfullyPlaceHints", self.assignment)
+
+    def test_constrained_hints_are_matched_before_duplicates_are_filled(self):
+        matching = self.assignment.index("tryAssignHint =")
+        commit = self.assignment.index("hintSignHints = hintSignHintsOriginal", matching)
+        duplicates = self.assignment.index("auto duplicateHints = hints")
+
+        self.assertLess(matching, commit)
+        self.assertLess(commit, duplicates)
+
+    def test_scarce_hint_signs_are_reserved_while_hints_are_selected(self):
+        for marker in (
+            "bool HintGenerator::CheckAvailableSign",
+            "void HintGenerator::ReserveLimitedAvailabilityHint",
+            "this->_reservedSigns.contains(sign)",
+            "possibleHintSigns.size() <= 2",
+            "hint.reservedSign =",
+            "this->_reservedSigns.insert(hint.reservedSign)",
+        ):
+            self.assertIn(marker, self.source)
+
+        self.assertIn("std::unordered_set<location::Location*> _reservedSigns", self.header)
+        self.assertIn("location::Location* reservedSign = nullptr", self.hint_types)
+
+    def test_all_location_based_hint_types_check_sign_availability(self):
+        self.assertIn(
+            'CheckAvailableSign(location, "Path Hints on Hint Signs")',
+            self.source,
+        )
+        self.assertGreaterEqual(
+            self.source.count(
+                'CheckAvailableSign(hintLocation, "Item Hints on Hint Signs")'
+            ),
+            1,
+        )
+        self.assertGreaterEqual(
+            self.source.count(
+                'CheckAvailableSign(hintLocation, "Location Hints on Hint Signs")'
+            ),
+            2,
+        )
+
+    def test_scarce_path_item_and_remote_hints_record_reservations(self):
+        for hint_type in ("Path", "Item", "Location"):
+            self.assertIn(
+                f'ReserveLimitedAvailabilityHint(hintLocation, "{hint_type} Hints on Hint Signs", hint)',
+                self.source,
+            )
+
+    def test_expensive_sign_searches_are_lazy_and_cached(self):
+        for generation in (
+            self.item_generation,
+            self.remote_generation,
+            self.location_generation,
+        ):
+            collection = generation[: generation.index("ShufflePool")]
+            self.assertNotIn("CheckAvailableSign", collection)
+
+        self.assertIn("_possibleHintSignsByLocation.try_emplace", self.source)
+        self.assertIn("if (inserted)", self.source)
+        self.assertIn("_possibleHintSignsByLocation", self.header)
+
+    def test_rejected_remote_candidates_are_consumed_instead_of_retried_forever(self):
+        self.assertIn(
+            "while (selectedHints < numLocationHints && !remoteLocations.empty())",
+            self.remote_generation,
+        )
+        self.assertIn("remoteLocations.pop_back()", self.remote_generation)
+        self.assertNotIn("--i", self.remote_generation)
+
+
+if __name__ == "__main__":
+    unittest.main()
