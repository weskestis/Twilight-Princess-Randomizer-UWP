+HookAction hookPreNameInputWaitRandomizerGate(
+    ModContext*, void* args, void*, void*)
+{
+    // A missing or invalid memory card reaches the name entry screen through
+    // ToNameMove/ToNameMove2 instead of selectDataNameMove.  The normal
+    // Randomizer gate is therefore never shown on that path, leaving no seed
+    // selected and causing the new-save callback to fail after horse naming.
+    // Catch the shared final state so every route must pass the seed gate.
+    if (ui::g_file_select_window_ctx.is_proceed) {
+        return HOOK_CONTINUE;
+    }
+
+    if (ui::g_dialogSelectModeState == ui::SelectReady) {
+        ui::g_dialogSelectModeState = ui::SelectWait;
+        auto* fileSelect = mods::arg<dFile_select_c*>(args, 0);
+        const ModResult result = ui::buildFileSelectGateMenu(fileSelect);
+        if (result != MOD_OK) {
+            ui::g_dialogSelectModeState = ui::SelectReady;
+            mods::log::error("Failed to build Randomizer gate before name entry");
+        }
+    }
+
+    return HOOK_SKIP_ORIGINAL;
+}
