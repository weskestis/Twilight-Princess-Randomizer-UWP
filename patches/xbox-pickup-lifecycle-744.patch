+void recoverMissingPickupMessage(daAlink_c* link, u32 messageId, BOOL& finished,
+                                PickupMessageGuard::Clock::time_point now) {
+    if (finished || link == nullptr || link->mProcID != daAlink_c::PROC_GET_ITEM) {
+        s_pickupMessageGuard.reset(); return;
+    }
+    auto* partner = fopAcM_getItemEventPartner(link);
+    if (partner == nullptr || fpcM_IsCreating(fpcM_GetID(partner)) ||
+        !breakables::has_spawned_item_binding(partner)) {
+        s_pickupMessageGuard.reset(); return;
+    }
+    auto* message = fopMsgM_SearchByID(link->mMsgClassID);
+    const bool creating = link->mMsgClassID != fpcM_ERROR_PROCESS_ID_e &&
+        link->mMsgClassID != 0 && fpcM_IsCreating(link->mMsgClassID);
+    // messageSet returns 0 when the shared message actor is not ready. The
+    // vanilla caller stores that as a live ID and otherwise never retries.
+    if (message == nullptr && !creating) link->mMsgClassID = fpcM_ERROR_PROCESS_ID_e;
+    const bool unavailable = message == nullptr || message->mode == fopMsg_MODE_MSG_PREPARING_e;
+    if (!s_pickupMessageGuard.expired(fopAcM_GetID(link), fopAcM_GetID(partner),
+                                    messageId, unavailable, creating, now)) return;
+    if (message != nullptr) message->mode = fopMsg_MODE_MSG_DESTROYED_e;
+    // Returning true lets procCoGetItem run its normal animation/event cleanup
+    // and mark the display actor dead. Its .744 grant binding remains intact.
+    finished = TRUE;
+    s_pickupMessageGuard.reset();
+    try {
+        mods::log::warn("Recovered missing breakable pickup text (744)");
+        if (session::svc_mng.ui != nullptr) {
+            UiToastDesc toast = UI_TOAST_DESC_INIT;
+            toast.title_rml = "Reward received";
+            toast.body_rml = "Pickup text could not open. Your reward is being added.";
+            toast.duration_ms = 5000;
+            session::svc_mng.ui->push_toast(session::svc_mng.mod_ctx, &toast);
+        }
+    } catch (...) {}
+}
