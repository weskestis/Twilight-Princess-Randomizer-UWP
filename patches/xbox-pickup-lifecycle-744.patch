diff --git a/mods/randomizer/src/pickup_message_guard.hpp b/mods/randomizer/src/pickup_message_guard.hpp
new file mode 100644
index 0000000..4b6f8ee
--- /dev/null
+++ b/mods/randomizer/src/pickup_message_guard.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <chrono>
+#include <cstdint>
+
+namespace randomizer {
+class PickupMessageGuard {
+public:
+    using Clock = std::chrono::steady_clock;
+    void reset() noexcept { mPending = false; }
+    bool expired(uint32_t player, uint32_t partner, uint32_t text, bool unavailable,
+                 bool creating, Clock::time_point now) noexcept {
+        if (!unavailable || creating) { reset(); return false; }
+        if (!mPending || player != mPlayer || partner != mPartner || text != mText) {
+            mPlayer=player; mPartner=partner; mText=text; mStarted=now; mPending=true;
+            return false;
+        }
+        return now-mStarted >= std::chrono::seconds(5);
+    }
+private:
+    uint32_t mPlayer=0, mPartner=0, mText=0;
+    bool mPending=false;
+    Clock::time_point mStarted{};
+};
+}
