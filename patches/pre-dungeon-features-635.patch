@@ -0,0 +1,47 @@
+#include "breakable_data.hpp"
+
+#include <array>
+#include <cstdint>
+
+namespace randomizer::breakables {
+namespace {
+
+struct StaticDefinition {
+    uint64_t key;
+    uint8_t stage;
+    int8_t room;
+    Kind kind;
+    uint16_t layerMask;
+    bool common;
+    bool progressionSafe;
+};
+
+// Generated by tools/build_breakable_data.py from the private, verified
+// GZ2E01 manifest (SHA-256
+// 95881d4edbb675b53a76a7dff7a5f4acb0a7389d51d68baedb93acd24cc4b608).
+constexpr auto kDefinitions = std::to_array<StaticDefinition>({
+#include "breakable_data.inc"
+});
+
+}  // namespace
+
+std::vector<Definition> load_breakable_definitions() {
+    std::vector<Definition> definitions;
+    definitions.reserve(kDefinitions.size());
+    for (uint32_t index = 0; index < kDefinitions.size(); ++index) {
+        const auto& source = kDefinitions[index];
+        definitions.push_back(Definition{
+            .key = source.key,
+            .index = index,
+            .stage = source.stage,
+            .room = source.room,
+            .kind = source.kind,
+            .layerMask = source.layerMask,
+            .common = source.common,
+            .progressionSafe = source.progressionSafe,
+        });
+    }
+    return definitions;
+}
+
+}  // namespace randomizer::breakables
