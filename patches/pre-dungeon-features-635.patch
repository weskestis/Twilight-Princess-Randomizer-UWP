+    void World::SetBreakableDefinitions(const std::vector<breakables::Definition>& definitions)
+    {
+        this->_breakableDefinitions = definitions;
+    }
+
+    void World::AddBreakableLocations()
+    {
+        if (this->_breakableDefinitions.empty())
+        {
+            return;
+        }
+
+        auto optionIncludes = [](const seedgen::settings::Setting& setting, bool dungeon)
+        {
+            return setting == "All" || (setting == "Dungeons" && dungeon) ||
+                   (setting == "Overworld" && !dungeon);
+        };
+
+        for (const auto& definition : this->_breakableDefinitions)
+        {
+            const bool dungeon = breakables::is_main_dungeon_stage(definition.stage);
+            const auto& setting = definition.kind == breakables::Kind::Pot
+                                      ? this->Setting("Pots")
+                                      : this->Setting("Pumpkins");
+            if (!optionIncludes(setting, dungeon))
+            {
+                continue;
+            }
+
+            std::ostringstream name;
+            name << breakables::kind_name(definition.kind) << " " << std::setfill('0')
+                 << std::setw(4) << definition.index << " (" << allStages[definition.stage]
+                 << ", " << (definition.room < 0 ? "Stage" : "Room " + std::to_string(definition.room))
+                 << ")";
+
+            YAML::Node metadata;
+            metadata["Breakable"]["Key"] = std::to_string(definition.key);
+            metadata["Breakable"]["Index"] = definition.index;
+            metadata["Breakable"]["Stage"] = definition.stage;
+            metadata["Breakable"]["Room"] = static_cast<int>(definition.room);
+            metadata["Breakable"]["Kind"] = static_cast<uint8_t>(definition.kind);
+
+            std::unordered_set<std::string> categories{
+                "Breakable",
+                definition.kind == breakables::Kind::Pot ? "Pot" : "Pumpkin",
+                dungeon ? "Dungeon" : "Overworld",
+            };
+            for (const auto& category : categories)
+            {
+                this->_registeredLocationCategories.insert(category);
+            }
+
+            auto location = std::make_unique<location::Location>(
+                this->_nextLocationId++, name.str(), categories, this, item::Nothing.get(),
+                false, name.str(), "Never", metadata);
+            location->SetRegisteredLocationCategories(&this->_registeredLocationCategories);
+
+            const auto accessRequirement = requirement::ParseRequirementString(
+                breakable_requirement(definition), this);
+            const auto accessAreas = breakable_access_areas(definition);
+            if (accessAreas.empty())
+            {
+                throw std::runtime_error("Breakable definition has no authored access path");
+            }
+            for (const auto areaName : accessAreas)
+            {
+                auto* breakableArea = this->GetArea(std::string(areaName));
+                auto access = std::make_unique<area::LocationAccess>(
+                    location.get(), accessRequirement, breakableArea);
+                location->AddLocationAccess(access.get());
+                breakableArea->AddLocation(std::move(access));
+            }
+            this->_locationTable.emplace(name.str(), std::move(location));
+        }
+    }
