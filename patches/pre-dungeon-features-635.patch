+void update_runtime_cosmetics_impl(bool force) noexcept {
+    try {
+        auto& settings = getSettings().cosmetics;
+        auto& state = runtime_color_state();
+
+        if (settings.randomizeAllColorsEveryLoad.getValue()) {
+            // Every-load colors are intentionally fixed until the next actual
+            // play-scene transition. Rainbow selections remain saved but dormant.
+            return;
+        }
+
+        if (state.everyLoadPaletteActive) {
+            clear_runtime_color_values();
+            state.everyLoadPaletteActive = false;
+            force = true;
+        }
+
+        const auto interval = rainbow_interval().count();
+        const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        const std::size_t index = static_cast<std::size_t>(elapsed / interval);
+        if (!force && state.rainbowIndex == index) {
+            return;
+        }
+        state.rainbowIndex = index;
+
+        bool changed = false;
+        const auto& targets = color_targets();
+        for (std::size_t targetIndex = 0; targetIndex < targets.size(); ++targetIndex) {
+            const auto& target = targets[targetIndex];
+            if (target.option->getValueForSave() == "Rainbow") {
+                // Offset each target so linked surfaces (especially menu text
+                // and background) do not rotate through identical colors.
+                const std::string value = rainbow_value(target, index + targetIndex);
+                target.option->setRuntimeValue(value);
+                changed = true;
+            } else if (target.option->hasRuntimeValue()) {
+                target.option->clearRuntimeValue();
+                changed = true;
+            }
+        }
+
+        if (changed || force) {
+            finish_runtime_color_change();
+        }
+    } catch (...) {
+        // Runtime cosmetics must never interrupt gameplay.
+    }
+}
