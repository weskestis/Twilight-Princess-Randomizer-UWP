+constexpr uint32_t kCollectionMagic = 0x42525054;  // TPRB in little-endian bytes
+constexpr uint16_t kCollectionVersion = 1;
+constexpr size_t kCollectionHeaderSize = 20;
+
+std::mutex s_mutex;
+std::unordered_map<fpc_ProcID, uint64_t> s_actorKeys;
+std::unordered_map<fpc_ProcID, uint64_t> s_spawnedItemKeys;
+std::unordered_set<uint64_t> s_pendingKeys;
+std::unordered_set<uint64_t> s_collectedKeys;
+uint64_t s_loadedSaveRevision = 0;
+uint64_t s_loadedSeedFingerprint = 0;
+int32_t s_loadedSlot = -2;
+
+uint64_t seed_fingerprint(std::string_view hashText) noexcept {
+    uint64_t hash = 14695981039346656037ULL;
+    for (const char value : hashText) {
+        hash ^= static_cast<uint8_t>(value);
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+void append_u16(std::vector<uint8_t>& bytes, uint16_t value) {
+    bytes.push_back(static_cast<uint8_t>(value));
+    bytes.push_back(static_cast<uint8_t>(value >> 8));
+}
+
+void append_u32(std::vector<uint8_t>& bytes, uint32_t value) {
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        bytes.push_back(static_cast<uint8_t>(value >> shift));
+    }
+}
+
+void append_u64(std::vector<uint8_t>& bytes, uint64_t value) {
+    for (unsigned shift = 0; shift < 64; shift += 8) {
+        bytes.push_back(static_cast<uint8_t>(value >> shift));
+    }
+}
+
+std::optional<uint16_t> read_u16(std::span<const uint8_t> bytes, size_t& offset) {
+    if (offset > bytes.size() || bytes.size() - offset < 2) {
+        return std::nullopt;
+    }
+    const uint16_t value = static_cast<uint16_t>(bytes[offset]) |
+                           (static_cast<uint16_t>(bytes[offset + 1]) << 8);
+    offset += 2;
+    return value;
+}
+
+std::optional<uint32_t> read_u32(std::span<const uint8_t> bytes, size_t& offset) {
+    if (offset > bytes.size() || bytes.size() - offset < 4) {
+        return std::nullopt;
+    }
+    uint32_t value = 0;
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        value |= static_cast<uint32_t>(bytes[offset++]) << shift;
+    }
+    return value;
+}
+
+std::optional<uint64_t> read_u64(std::span<const uint8_t> bytes, size_t& offset) {
+    if (offset > bytes.size() || bytes.size() - offset < 8) {
+        return std::nullopt;
+    }
+    uint64_t value = 0;
+    for (unsigned shift = 0; shift < 64; shift += 8) {
+        value |= static_cast<uint64_t>(bytes[offset++]) << shift;
+    }
+    return value;
+}
+
+void load_collection_locked(uint64_t fingerprint) {
+    s_collectedKeys.clear();
+    const auto blob = dusk::mods::svc::save_get_builtin_blob(kCollectionBlobName);
+    if (!blob || blob->size() < kCollectionHeaderSize) {
+        return;
+    }
+
+    const std::span<const uint8_t> bytes(*blob);
+    size_t offset = 0;
+    const auto magic = read_u32(bytes, offset);
+    const auto version = read_u16(bytes, offset);
+    const auto reserved = read_u16(bytes, offset);
+    const auto storedFingerprint = read_u64(bytes, offset);
+    const auto count = read_u32(bytes, offset);
+    (void)reserved;
+    if (!magic || !version || !storedFingerprint || !count || *magic != kCollectionMagic ||
+        *version != kCollectionVersion || *storedFingerprint != fingerprint ||
+        *count > (bytes.size() - kCollectionHeaderSize) / sizeof(uint64_t) ||
+        bytes.size() != kCollectionHeaderSize + static_cast<size_t>(*count) * sizeof(uint64_t)) {
+        DuskLog.warn("Ignoring malformed or wrong-seed breakable save data");
+        return;
+    }
+
+    const auto& overrides = randomizer_GetContext().mBreakableOverrides;
+    for (uint32_t index = 0; index < *count; ++index) {
+        const auto key = read_u64(bytes, offset);
+        if (!key) {
+            s_collectedKeys.clear();
+            return;
+        }
+        if (overrides.contains(*key)) {
+            s_collectedKeys.insert(*key);
+        }
+    }
+}
+
+void ensure_collection_locked() {
+    const auto revision = dusk::mods::svc::save_state_revision();
+    const auto slot = dusk::mods::svc::save_current_slot();
+    const auto fingerprint = seed_fingerprint(randomizer_GetContext().mHash);
+    if (revision == s_loadedSaveRevision && slot == s_loadedSlot &&
+        fingerprint == s_loadedSeedFingerprint) {
+        return;
+    }
+
+    s_loadedSaveRevision = revision;
+    s_loadedSlot = slot;
+    s_loadedSeedFingerprint = fingerprint;
+    s_actorKeys.clear();
+    s_spawnedItemKeys.clear();
+    s_pendingKeys.clear();
+    if (slot < 0 || randomizer_GetContext().mHash.empty()) {
+        s_collectedKeys.clear();
+        return;
+    }
+    load_collection_locked(fingerprint);
+}
+
+void persist_collection_locked() {
+    if (s_loadedSlot < 0 || randomizer_GetContext().mHash.empty()) {
+        return;
+    }
+    std::vector<uint64_t> keys(s_collectedKeys.begin(), s_collectedKeys.end());
+    std::ranges::sort(keys);
+
+    std::vector<uint8_t> bytes;
+    bytes.reserve(kCollectionHeaderSize + keys.size() * sizeof(uint64_t));
+    append_u32(bytes, kCollectionMagic);
+    append_u16(bytes, kCollectionVersion);
+    append_u16(bytes, 0);
+    append_u64(bytes, s_loadedSeedFingerprint);
+    append_u32(bytes, static_cast<uint32_t>(keys.size()));
+    for (const auto key : keys) {
+        append_u64(bytes, key);
+    }
+    if (!dusk::mods::svc::save_set_builtin_blob(kCollectionBlobName, bytes.data(),
+                                                 bytes.size())) {
+        DuskLog.error("Could not stage breakable collection data for the current save slot");
+    }
+}
+
+std::string_view pot_actor_name(uint16_t type) noexcept {
+    switch (type) {
+    case daObjCarry_c::TYPE_TSUBO:
+        return "carry00";
+    case daObjCarry_c::TYPE_OOTSUBO:
+        return "carry01";
+    case daObjCarry_c::TYPE_TSUBO_2:
+        return "carry07";
+    case daObjCarry_c::TYPE_AOTSUBO:
+        // The stage actor table has no carry10 alias, so use this synthetic
+        // canonical name in both the offline inventory and runtime identity.
+        return "carry10";
+    case daObjCarry_c::TYPE_TSUBO_S:
+        return "carry12";
+    case daObjCarry_c::TYPE_TSUBO_B:
+        return "carry13";
+    default:
+        return {};
+    }
+}
+
+ActorIdentity identity_for_actor(fopAc_ac_c* actor, std::string_view name) noexcept {
+    const uint8_t stage = static_cast<uint8_t>(getStageID());
+    return ActorIdentity{
+        .stage = stage,
+        .room = fopAcM_GetHomeRoomNo(actor),
+        .layer = stage >= 35 && stage <= 39
+                     ? static_cast<int8_t>(dComIfG_play_c::getLayerNo(0))
+                     : int8_t{-1},
+        .actorName = name,
+        .parameters = fopAcM_GetParam(actor),
+        .x = actor->home.pos.x,
+        .y = actor->home.pos.y,
+        .z = actor->home.pos.z,
+        .angleX = actor->home.angle.x,
+        .angleY = actor->home.angle.y,
+        .angleZ = actor->home.angle.z,
+        .setId = static_cast<uint16_t>(fopAcM_GetSetId(actor)),
+    };
+}
+
+void register_actor(fopAc_ac_c* actor, std::string_view name) {
+    if (actor == nullptr || name.empty() || !randomizer_IsActive()) {
+        return;
+    }
+    const int stage = getStageID();
+    if (stage < 0 || stage > 0xFF) {
+        return;
+    }
+    const uint64_t key = make_key(identity_for_actor(actor, name));
+    if (!randomizer_GetContext().mBreakableOverrides.contains(key)) {
+        return;
+    }
+    std::scoped_lock lock(s_mutex);
+    ensure_collection_locked();
+    s_actorKeys[fopAcM_GetID(actor)] = key;
+}
+
+std::optional<uint64_t> spawned_key_locked(const fopAc_ac_c* actor) {
+    if (actor == nullptr) {
+        return std::nullopt;
+    }
+    const auto found = s_spawnedItemKeys.find(fopAcM_GetID(actor));
+    return found == s_spawnedItemKeys.end() ? std::nullopt
+                                            : std::optional<uint64_t>(found->second);
+}
+
+std::optional<fpc_ProcID> spawned_id_for_key_locked(uint64_t key) {
+    const auto found = std::ranges::find_if(
+        s_spawnedItemKeys, [key](const auto& entry) { return entry.second == key; });
+    return found == s_spawnedItemKeys.end()
+               ? std::nullopt
+               : std::optional<fpc_ProcID>(found->first);
+}
+
+}  // namespace
+
+uint64_t make_key(const ActorIdentity& identity) noexcept {
+    uint64_t hash = 14695981039346656037ULL;
+    auto appendByte = [&](uint8_t value) {
+        hash ^= value;
+        hash *= 1099511628211ULL;
+    };
+    auto append16 = [&](uint16_t value) {
+        appendByte(static_cast<uint8_t>(value >> 8));
+        appendByte(static_cast<uint8_t>(value));
+    };
+    auto append32 = [&](uint32_t value) {
+        appendByte(static_cast<uint8_t>(value >> 24));
+        appendByte(static_cast<uint8_t>(value >> 16));
+        appendByte(static_cast<uint8_t>(value >> 8));
+        appendByte(static_cast<uint8_t>(value));
+    };
+
+    static constexpr std::string_view domain = "TPR-BREAKABLE-V2";
+    for (const char ch : domain) {
+        appendByte(static_cast<uint8_t>(ch));
+    }
+    appendByte(identity.stage);
+    appendByte(static_cast<uint8_t>(identity.room));
+    for (size_t index = 0; index < 8; ++index) {
+        appendByte(index < identity.actorName.size()
+                       ? static_cast<uint8_t>(identity.actorName[index])
+                       : uint8_t{0});
+    }
+    appendByte(static_cast<uint8_t>(identity.layer));
+    append32(identity.parameters);
+    append32(std::bit_cast<uint32_t>(identity.x));
+    append32(std::bit_cast<uint32_t>(identity.y));
+    append32(std::bit_cast<uint32_t>(identity.z));
+    append16(static_cast<uint16_t>(identity.angleX));
+    append16(static_cast<uint16_t>(identity.angleY));
+    append16(static_cast<uint16_t>(identity.angleZ));
+    append16(identity.setId);
+    return hash;
+}
+
+bool is_main_dungeon_stage(uint8_t stage) noexcept {
+    // The main dungeon, miniboss, and boss stages occupy IDs 0 through 29.
+    // Stage 30 begins the optional cave/grotto group.
+    return stage <= 29;
+}
+
+const char* kind_name(Kind kind) noexcept {
+    return kind == Kind::Pot ? "Pot" : "Pumpkin";
+}
+
+void register_pot(fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return;
+        }
+        const uint16_t type = (static_cast<uint16_t>(actor->home.angle.z) >> 1) & 0x1F;
+        register_actor(actor, pot_actor_name(type));
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not register randomized pot: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not register randomized pot: unknown error");
+    }
+}
+
+void register_pumpkin(fopAc_ac_c* actor) noexcept {
+    try {
+        register_actor(actor, "Pumpkin");
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not register randomized pumpkin: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not register randomized pumpkin: unknown error");
+    }
+}
+
+void forget_actor(const fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return;
+        }
+        std::scoped_lock lock(s_mutex);
+        s_actorKeys.erase(fopAcM_GetID(actor));
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not forget randomized breakable: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not forget randomized breakable: unknown error");
+    }
+}
+
+void clear_scene_actors() noexcept {
+    try {
+        std::scoped_lock lock(s_mutex);
+        s_actorKeys.clear();
+        s_spawnedItemKeys.clear();
+        s_pendingKeys.clear();
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not clear randomized breakable scene state: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not clear randomized breakable scene state: unknown error");
+    }
+}
+
+bool is_shuffled_and_uncollected(const fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return false;
+        }
+        std::scoped_lock lock(s_mutex);
+        ensure_collection_locked();
+        const auto found = s_actorKeys.find(fopAcM_GetID(actor));
+        return found != s_actorKeys.end() && !s_collectedKeys.contains(found->second);
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not query randomized breakable state: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not query randomized breakable state: unknown error");
+    }
+    return false;
+}
+
+bool spawn_shuffled_item(fopAc_ac_c* actor, fpc_ProcID* spawnedItemId) noexcept {
+    if (spawnedItemId != nullptr) {
+        *spawnedItemId = fpcM_ERROR_PROCESS_ID_e;
+    }
+
+    uint64_t key = 0;
+    bool pendingInserted = false;
+    try {
+        if (actor == nullptr) {
+            return false;
+        }
+
+        uint8_t rawItem = 0xFF;
+        {
+            std::scoped_lock lock(s_mutex);
+            ensure_collection_locked();
+            const auto found = s_actorKeys.find(fopAcM_GetID(actor));
+            if (found == s_actorKeys.end()) {
+                return false;
+            }
+            key = found->second;
+            if (s_collectedKeys.contains(key)) {
+                return true;
+            }
+            if (s_pendingKeys.contains(key)) {
+                if (spawnedItemId != nullptr) {
+                    const auto pendingId = spawned_id_for_key_locked(key);
+                    if (pendingId) {
+                        *spawnedItemId = *pendingId;
+                    }
+                }
+                return true;
+            }
+            const auto override = randomizer_GetContext().mBreakableOverrides.find(key);
+            if (override == randomizer_GetContext().mBreakableOverrides.end()) {
+                return false;
+            }
+            rawItem = override->second.itemId;
+            if (rawItem == 0xFF) {
+                DuskLog.error("Ignoring invalid item for randomized breakable {}", key);
+                return false;
+            }
+            s_pendingKeys.insert(key);
+            pendingInserted = true;
+        }
+
+        cXyz position = actor->current.pos;
+        position.y += 15.0f;
+        csXyz angle(0, actor->home.angle.y, 0);
+        const uint8_t item = verifyProgressiveItem(rawItem);
+        const fpc_ProcID itemId = fopAcM_createItem(
+            &position, item, 0xFF, fopAcM_GetHomeRoomNo(actor), &angle, nullptr, 0);
+
+        std::scoped_lock lock(s_mutex);
+        if (itemId == fpcM_ERROR_PROCESS_ID_e) {
+            s_pendingKeys.erase(key);
+            DuskLog.error("Failed to create item {} for randomized breakable {}", item, key);
+            // Let the caller use its vanilla drop rather than silently lose an
+            // item. Because the location is not collected, reloading the room
+            // permits another attempt.
+            return false;
+        }
+        s_spawnedItemKeys[itemId] = key;
+        if (spawnedItemId != nullptr) {
+            *spawnedItemId = itemId;
+        }
+        return true;
+    } catch (const std::exception& error) {
+        if (pendingInserted) {
+            try {
+                std::scoped_lock lock(s_mutex);
+                s_pendingKeys.erase(key);
+            } catch (...) {
+            }
+        }
+        DuskLog.error("Could not spawn randomized breakable item: {}", error.what());
+    } catch (...) {
+        if (pendingInserted) {
+            try {
+                std::scoped_lock lock(s_mutex);
+                s_pendingKeys.erase(key);
+            } catch (...) {
+            }
+        }
+        DuskLog.error("Could not spawn randomized breakable item: unknown error");
+    }
+    return false;
+}
+
+bool refresh_spawned_item(fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return false;
+        }
+        uint8_t rawItem = 0xFF;
+        {
+            std::scoped_lock lock(s_mutex);
+            ensure_collection_locked();
+            const auto key = spawned_key_locked(actor);
+            if (!key) {
+                return false;
+            }
+            const auto override = randomizer_GetContext().mBreakableOverrides.find(*key);
+            if (override == randomizer_GetContext().mBreakableOverrides.end()) {
+                return false;
+            }
+            rawItem = override->second.itemId;
+        }
+        uint32_t parameters = fopAcM_GetParam(actor);
+        parameters = (parameters & 0xFFFFFF00U) | verifyProgressiveItem(rawItem);
+        fopAcM_SetParam(actor, parameters);
+        return true;
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not refresh randomized breakable item: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not refresh randomized breakable item: unknown error");
+    }
+    return false;
+}
+
+void collect_spawned_item(const fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return;
+        }
+        bool collected = false;
+        {
+            std::scoped_lock lock(s_mutex);
+            ensure_collection_locked();
+            const auto key = spawned_key_locked(actor);
+            if (!key) {
+                return;
+            }
+            s_spawnedItemKeys.erase(fopAcM_GetID(actor));
+            s_pendingKeys.erase(*key);
+            collected = s_collectedKeys.insert(*key).second;
+            if (collected) {
+                persist_collection_locked();
+            }
+        }
+        if (collected) {
+            g_randomizerState.mUpdateTracker = true;
+        }
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not collect randomized breakable item: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not collect randomized breakable item: unknown error");
+    }
+}
+
+void forget_spawned_item(const fopAc_ac_c* actor) noexcept {
+    try {
+        if (actor == nullptr) {
+            return;
+        }
+        std::scoped_lock lock(s_mutex);
+        const auto key = spawned_key_locked(actor);
+        if (key) {
+            s_pendingKeys.erase(*key);
+        }
+        s_spawnedItemKeys.erase(fopAcM_GetID(actor));
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not forget randomized breakable item: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not forget randomized breakable item: unknown error");
+    }
+}
+
+bool is_collected(uint64_t key) noexcept {
+    try {
+        std::scoped_lock lock(s_mutex);
+        ensure_collection_locked();
+        return s_collectedKeys.contains(key);
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not query randomized breakable collection: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not query randomized breakable collection: unknown error");
+    }
+    return false;
+}
+
+size_t collected_count(Kind kind) noexcept {
+    try {
+        std::scoped_lock lock(s_mutex);
+        ensure_collection_locked();
+        size_t count = 0;
+        for (const auto& [key, data] : randomizer_GetContext().mBreakableOverrides) {
+            if (data.kind == static_cast<uint8_t>(kind) && s_collectedKeys.contains(key)) {
+                ++count;
+            }
+        }
+        return count;
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not count collected randomized breakables: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not count collected randomized breakables: unknown error");
+    }
+    return 0;
+}
+
+size_t total_count(Kind kind) noexcept {
+    try {
+        const auto& overrides = randomizer_GetContext().mBreakableOverrides;
+        return static_cast<size_t>(std::ranges::count_if(overrides, [&](const auto& entry) {
+            return entry.second.kind == static_cast<uint8_t>(kind);
+        }));
+    } catch (const std::exception& error) {
+        DuskLog.error("Could not count randomized breakables: {}", error.what());
+    } catch (...) {
+        DuskLog.error("Could not count randomized breakables: unknown error");
+    }
+    return 0;
+}
+
+}  // namespace randomizer::breakables
