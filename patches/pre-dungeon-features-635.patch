+std::uint64_t next_runtime_random_value() noexcept {
+    static std::atomic<std::uint64_t> counter{0};
+    const auto steady = static_cast<std::uint64_t>(
+        std::chrono::steady_clock::now().time_since_epoch().count());
+    const auto wall = static_cast<std::uint64_t>(
+        std::chrono::system_clock::now().time_since_epoch().count());
+    std::uint64_t value = steady ^ (wall << 17) ^ (wall >> 13) ^
+        (counter.fetch_add(1, std::memory_order_relaxed) + 1);
+
+    // SplitMix64 finalization gives the clock/counter mixture uniform-looking
+    // color channels without relying on std::random_device in the UWP runtime.
+    value ^= value >> 30;
+    value *= 0xbf58476d1ce4e5b9ULL;
+    value ^= value >> 27;
+    value *= 0x94d049bb133111ebULL;
+    value ^= value >> 31;
+    return value;
+}
