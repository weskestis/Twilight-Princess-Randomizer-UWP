@@ -0,0 +1,150 @@
+import importlib.util
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+SCRIPT = Path(__file__).parents[1] / "extract_breakables_from_iso.py"
+SPEC = importlib.util.spec_from_file_location("extract_breakables_from_iso", SCRIPT)
+MODULE = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader is not None
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+
+def align(value, amount):
+    return (value + amount - 1) & -amount
+
+
+def actor(name, *, angle_z, set_id, parameters=0x12345678):
+    return struct.pack(
+        ">8sIfffhhhH",
+        name.encode("ascii").ljust(8, b"\0"),
+        parameters,
+        1.0,
+        2.0,
+        3.0,
+        -100,
+        200,
+        angle_z,
+        set_id,
+    )
+
+
+def dzs(chunks):
+    header_size = 4 + len(chunks) * 12
+    data_offset = align(header_size, 4)
+    output = bytearray(data_offset)
+    struct.pack_into(">I", output, 0, len(chunks))
+    payload = bytearray()
+    for index, (tag, entries) in enumerate(chunks):
+        offset = data_offset + len(payload)
+        output[4 + index * 12:8 + index * 12] = tag.encode("ascii")
+        struct.pack_into(">II", output, 8 + index * 12, len(entries), offset)
+        payload.extend(b"".join(entries))
+    output.extend(payload)
+    return bytes(output)
+
+
+def rarc(file_name, file_data):
+    data_header = 0x20
+    entry_table = 0x40
+    string_table = 0x60
+    name = file_name.encode("ascii") + b"\0"
+    file_data_offset = align(string_table + len(name), 0x20)
+    total_size = file_data_offset + len(file_data)
+    output = bytearray(total_size)
+
+    output[:4] = b"RARC"
+    struct.pack_into(">IIIIIII", output, 4, total_size, data_header,
+                     file_data_offset - data_header, len(file_data), len(file_data), 0, 0)
+    struct.pack_into(">IIIIIIHBBI", output, data_header,
+                     0, 0, 1, entry_table - data_header, len(name),
+                     string_table - data_header, 1, 1, 0, 0)
+    struct.pack_into(">HHIIII", output, entry_table,
+                     0, 0, 0x11000000, 0, len(file_data), 0)
+    output[string_table:string_table + len(name)] = name
+    output[file_data_offset:file_data_offset + len(file_data)] = file_data
+    return bytes(output)
+
+
+def iso_with_stage_archive(archive):
+    names = ("res", "Stage", "D_MN01", "STG_00.arc")
+    strings = bytearray()
+    offsets = []
+    for name in names:
+        offsets.append(len(strings))
+        strings.extend(name.encode("ascii") + b"\0")
+
+    entries = [
+        (0x01000000, 0, 5),
+        (0x01000000 | offsets[0], 0, 5),
+        (0x01000000 | offsets[1], 1, 5),
+        (0x01000000 | offsets[2], 2, 5),
+        (offsets[3], 0x1000, len(archive)),
+    ]
+    fst = bytearray()
+    for entry in entries:
+        fst.extend(struct.pack(">III", *entry))
+    fst.extend(strings)
+
+    image = bytearray(0x1000 + len(archive))
+    image[:6] = b"GZ2E01"
+    image[0x500:0x500 + len(fst)] = fst
+    struct.pack_into(">III", image, 0x424, 0x500, len(fst), len(fst))
+    image[0x1000:] = archive
+    return bytes(image)
+
+
+class ExtractBreakablesTests(unittest.TestCase):
+    def test_grotto_layers_are_distinct_but_story_layers_share_identity(self):
+        entry = actor("carry00", angle_z=0, set_id=7)
+        grotto_a = MODULE.placement_key(36, 1, "carry00", entry, "0")
+        grotto_b = MODULE.placement_key(36, 1, "carry00", entry, "3")
+        story_a = MODULE.placement_key(43, 0, "Pumpkin", entry, "0")
+        story_b = MODULE.placement_key(43, 0, "Pumpkin", entry, "7")
+        self.assertNotEqual(grotto_a, grotto_b)
+        self.assertEqual(story_a, story_b)
+
+    def test_full_disc_inventory_and_canonical_pot_type(self):
+        stage_dzs = dzs([
+            ("ACTR", [
+                actor("carry00", angle_z=0x14, set_id=7),  # Type 0x0A big blue pot.
+                actor("carry05", angle_z=0x0A, set_id=8),  # Type 0x05 skull.
+            ]),
+            ("ACT1", [actor("Pumpkin", angle_z=0, set_id=9)]),
+        ])
+        image = iso_with_stage_archive(rarc("stage.dzs", stage_dzs))
+        with tempfile.TemporaryDirectory() as directory:
+            image_path = Path(directory) / "test.iso"
+            image_path.write_bytes(image)
+            manifest = MODULE.inventory(image_path)
+
+        self.assertEqual(manifest["source"]["disc_id"], "GZ2E01")
+        self.assertEqual(manifest["counts"]["placement_records"], 2)
+        self.assertEqual(manifest["counts"]["unique_runtime_keys"], 2)
+        self.assertEqual(manifest["counts"]["pot_keys"], 1)
+        self.assertEqual(manifest["counts"]["pumpkin_keys"], 1)
+        self.assertEqual(manifest["counts"]["layered_keys"], 1)
+
+        pot = next(item for item in manifest["placements"] if item["kind"] == "Pot")
+        self.assertEqual(pot["actor"], "carry00")
+        self.assertEqual(pot["canonical_actor"], "carry10")
+        self.assertEqual(pot["pot_type"], 0x0A)
+        self.assertEqual(pot["room"], -1)
+
+        pumpkin = next(item for item in manifest["placements"] if item["kind"] == "Pumpkin")
+        self.assertEqual(pumpkin["layer"], "1")
+
+    def test_rejects_truncated_disc(self):
+        with tempfile.TemporaryDirectory() as directory:
+            image_path = Path(directory) / "bad.iso"
+            image_path.write_bytes(b"GZ2E01")
+            with self.assertRaises(MODULE.FormatError):
+                MODULE.inventory(image_path)
+
+
+if __name__ == "__main__":
+    unittest.main()
