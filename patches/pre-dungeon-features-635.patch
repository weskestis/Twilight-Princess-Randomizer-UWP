+std::vector<std::string_view> grotto_access_areas(const Definition& definition)
+{
+    struct LayerArea
+    {
+        uint8_t stage;
+        uint8_t layer;
+        std::string_view area;
+    };
+    static constexpr auto kLayerAreas = std::to_array<LayerArea>({
+        {35, 0, "Outside Castle Town West Helmasaur Grotto"},
+        {35, 1, "Eldin Field Bomskit Grotto"},
+        {35, 2, "Ordon Ranch Grotto"},
+        {35, 3, "Lanayru Field Poe Grotto"},
+        {36, 0, "Eldin Field Stalfos Grotto"},
+        {36, 1, "Faron Field Corner Grotto"},
+        {36, 2, "Lost Woods Baba Serpent Grotto"},
+        {36, 3, "Kakariko Gorge Keese Grotto"},
+        {37, 0, "Gerudo Desert Rock Grotto"},
+        {37, 1, "Gerudo Desert Chu Grotto"},
+        {37, 2, "Snowpeak Ice Keese Grotto"},
+        {37, 3, "Lanayru Field Chu Grotto"},
+        {38, 0, "Lake Hylia Bridge Bubble Grotto"},
+        {38, 1, "Gerudo Desert Skulltula Grotto"},
+        {38, 2, "Snowpeak Freezard Grotto"},
+        {38, 3, "Lanayru Field Skulltula Grotto"},
+        {39, 0, "Outside Castle Town South Tektite Grotto"},
+        {39, 1, "Faron Field Fishing Grotto"},
+        {39, 2, "Lake Hylia Water Toadpoli Grotto"},
+        {39, 3, "Eldin Field Water Bomb Fish Grotto"},
+        {39, 4, "Lake Hylia Shell Blade Grotto"},
+    });
+
+    std::vector<std::string_view> areas;
+    uint16_t mappedMask = 0;
+    for (const auto& mapping : kLayerAreas)
+    {
+        const uint16_t bit = static_cast<uint16_t>(1U << mapping.layer);
+        if (mapping.stage == definition.stage && (definition.layerMask & bit) != 0)
+        {
+            areas.push_back(mapping.area);
+            mappedMask |= bit;
+        }
+    }
+    if (mappedMask != definition.layerMask)
+    {
+        throw std::runtime_error("Breakable grotto definition has an unmapped actor layer");
+    }
+    return areas;
+}
+
+std::vector<std::string_view> breakable_access_areas(const Definition& definition)
+{
+    const uint8_t stage = definition.stage;
+    if (stage <= 29)
+        return dungeon_breakable_access_areas(definition);
+    if (stage >= 35 && stage <= 39)
+        return grotto_access_areas(definition);
+
+    switch (stage)
+    {
+    case 43:
+        return {"Ordon Village"};
+    case 49:
+        return {"Upper Zoras River"};
+    case 51:
+        return definition.room == 2 ? std::vector<std::string_view>{"Snowpeak Summit Cave"}
+                                    : std::vector<std::string_view>{"Snowpeak Climb Upper"};
+    case 52:
+        // Reaching Falbi's upper platform is a conservative superset of the
+        // access needed by the pots spread through Lake Hylia's shared room.
+        return {"Flight by Fowl"};
+    case 53:
+        return {"Castle Town East"};
+    case 54:
+        return {"Sacred Grove Past Behind Window"};
+    case 55:
+        return {"Bulblin Camp"};
+    case 57:
+        return {"Outside Castle Town South Inside Boulder"};
+    case 59:
+        return {"Gerudo Desert Cave of Ordeals Plateau"};
+    case 65:
+        return {"Ordon Shield House Upper Ledge"};
+    case 68:
+        switch (definition.room)
+        {
+        case 2:
+            return {"Kakariko Elde Inn"};
+        case 3:
+            return {"Kakariko Malo Mart"};
+        case 4:
+            return {"Kakariko Watchtower Upper Interior"};
+        case 5:
+            return {"Kakariko Barnes Bomb Shop Upper"};
+        default:
+            break;
+        }
+        break;
+    case 70:
+        return {"Castle Town Telmas Bar"};
+    case 73:
+        return {"Castle Town Doctors Office Upper"};
+    default:
+        break;
+    }
+    throw std::runtime_error("Breakable definition has no authored logic area");
+}
+
+std::string breakable_requirement(const Definition& definition)
+{
+    std::string requirement = "Can_Collect_Every_Breakable";
+    if (definition.stage == 52)
+    {
+        requirement += " and Can_Complete_Lanayru_Twilight";
+    }
+    else if (definition.stage == 68)
+    {
+        requirement += " and Can_Complete_Eldin_Twilight";
+    }
+    return requirement;
+}
