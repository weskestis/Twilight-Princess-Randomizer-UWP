+++ b/tools/extract_breakables_from_iso.py
@@ -0,0 +1,624 @@
+#!/usr/bin/env python3
+"""Inventory Twilight Princess pots and pumpkins directly from a GCN disc image.
+
+The output intentionally contains only placement metadata needed to author
+randomizer logic. No game archive or other copyrighted binary data is emitted.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import re
+import struct
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import BinaryIO, Iterable
+
+
+MAX_FST_SIZE = 64 * 1024 * 1024
+MAX_ARCHIVE_SIZE = 256 * 1024 * 1024
+ACTOR_SIZE = 0x20
+SCALED_ACTOR_SIZE = 0x24
+FNV_OFFSET_BASIS = 14695981039346656037
+FNV_PRIME = 1099511628211
+KEY_DOMAIN = b"TPR-BREAKABLE-V2"
+
+CARRY_ACTORS = frozenset({
+    "carry00", "carry01", "carry02", "carry04", "carry05", "carry06", "carry07",
+    "carry08", "carry09", "ball1", "ball2", "ball3", "carry12", "carry13",
+})
+POT_KEY_NAMES = {
+    0x00: "carry00",  # Small blue pot
+    0x01: "carry01",  # Big red pot
+    0x07: "carry07",  # Small red pot
+    0x0A: "carry10",  # Big blue pot (synthetic stable identity name)
+    0x0C: "carry12",  # Small Twilight pot
+    0x0D: "carry13",  # Big Twilight pot
+}
+LAYER_CHARS = frozenset("0123456789abcde")
+
+STAGES = (
+    "D_MN01", "D_MN01A", "D_MN01B", "D_MN04", "D_MN04A", "D_MN04B",
+    "D_MN05", "D_MN05A", "D_MN05B", "D_MN06", "D_MN06A", "D_MN06B",
+    "D_MN07", "D_MN07A", "D_MN07B", "D_MN08", "D_MN08A", "D_MN08B",
+    "D_MN08C", "D_MN08D", "D_MN09", "D_MN09A", "D_MN09B", "D_MN09C",
+    "D_MN10", "D_MN10A", "D_MN10B", "D_MN11", "D_MN11A", "D_MN11B",
+    "D_SB00", "D_SB01", "D_SB02", "D_SB03", "D_SB04", "D_SB05", "D_SB06",
+    "D_SB07", "D_SB08", "D_SB09", "D_SB10", "F_SP00", "F_SP102", "F_SP103",
+    "F_SP104", "F_SP108", "F_SP109", "F_SP110", "F_SP111", "F_SP112",
+    "F_SP113", "F_SP114", "F_SP115", "F_SP116", "F_SP117", "F_SP118",
+    "F_SP121", "F_SP122", "F_SP123", "F_SP124", "F_SP125", "F_SP126",
+    "F_SP127", "F_SP128", "F_SP200", "R_SP01", "R_SP107", "R_SP108",
+    "R_SP109", "R_SP110", "R_SP116", "R_SP127", "R_SP128", "R_SP160",
+    "R_SP161", "R_SP209", "R_SP300", "R_SP301",
+)
+STAGE_IDS = {name.casefold(): index for index, name in enumerate(STAGES)}
+
+
+class FormatError(RuntimeError):
+    """Raised for malformed or unsupported disc data."""
+
+
+@dataclass(frozen=True)
+class DiscFile:
+    path: str
+    offset: int
+    size: int
+
+
+def be16(data: bytes, offset: int) -> int:
+    require_range(data, offset, 2, "16-bit value")
+    return struct.unpack_from(">H", data, offset)[0]
+
+
+def be32(data: bytes, offset: int) -> int:
+    require_range(data, offset, 4, "32-bit value")
+    return struct.unpack_from(">I", data, offset)[0]
+
+
+def require_range(data: bytes, offset: int, size: int, what: str) -> None:
+    if offset < 0 or size < 0 or offset > len(data) or size > len(data) - offset:
+        raise FormatError(f"Malformed {what} range")
+
+
+def bounded_c_string(data: bytes, offset: int, limit: int, what: str) -> str:
+    require_range(data, offset, 1, what)
+    end_limit = min(len(data), offset + limit)
+    end = data.find(b"\0", offset, end_limit)
+    if end < 0:
+        raise FormatError(f"Unterminated {what}")
+    try:
+        return data[offset:end].decode("ascii")
+    except UnicodeDecodeError as error:
+        raise FormatError(f"Non-ASCII {what}") from error
+
+
+def read_fst(image: BinaryIO, image_size: int) -> tuple[str, list[DiscFile]]:
+    image.seek(0)
+    disc_id_bytes = image.read(6)
+    if len(disc_id_bytes) != 6:
+        raise FormatError("Disc image is too small")
+    try:
+        disc_id = disc_id_bytes.decode("ascii")
+    except UnicodeDecodeError as error:
+        raise FormatError("Disc ID is not ASCII") from error
+
+    image.seek(0x424)
+    fst_header = image.read(12)
+    if len(fst_header) != 12:
+        raise FormatError("Disc image has no GameCube FST header")
+    fst_offset, fst_size, fst_max_size = struct.unpack(">III", fst_header)
+    if (
+        fst_offset == 0
+        or fst_size < 12
+        or fst_size > MAX_FST_SIZE
+        or fst_size > fst_max_size
+        or fst_offset > image_size
+        or fst_size > image_size - fst_offset
+    ):
+        raise FormatError("Invalid GameCube FST bounds")
+
+    image.seek(fst_offset)
+    fst = image.read(fst_size)
+    if len(fst) != fst_size:
+        raise FormatError("Could not read complete GameCube FST")
+
+    root_type_and_name, root_parent, entry_count = struct.unpack_from(">III", fst, 0)
+    if root_type_and_name >> 24 == 0 or root_parent != 0:
+        raise FormatError("Invalid GameCube FST root entry")
+    if entry_count == 0 or entry_count > len(fst) // 12:
+        raise FormatError("Invalid GameCube FST entry count")
+    string_table = entry_count * 12
+
+    entries: list[tuple[bool, str, int, int]] = []
+    for index in range(entry_count):
+        type_and_name, value_a, value_b = struct.unpack_from(">III", fst, index * 12)
+        is_dir = (type_and_name >> 24) != 0
+        name_offset = type_and_name & 0x00FFFFFF
+        if index == 0:
+            name = ""
+        else:
+            if name_offset >= len(fst) - string_table:
+                raise FormatError("Invalid GameCube FST name offset")
+            name = bounded_c_string(
+                fst, string_table + name_offset, len(fst) - string_table - name_offset,
+                "GameCube FST name",
+            )
+            if not name or "/" in name or "\\" in name:
+                raise FormatError("Invalid GameCube FST entry name")
+        entries.append((is_dir, name, value_a, value_b))
+
+    files: list[DiscFile] = []
+
+    def walk(directory_index: int, prefix: str, ancestors: frozenset[int]) -> int:
+        if directory_index in ancestors:
+            raise FormatError("Cyclic GameCube FST directory")
+        is_dir, _, _, end_index = entries[directory_index]
+        if not is_dir or end_index <= directory_index or end_index > entry_count:
+            raise FormatError("Invalid GameCube FST directory span")
+
+        index = directory_index + 1
+        next_ancestors = ancestors | {directory_index}
+        while index < end_index:
+            child_is_dir, name, value_a, value_b = entries[index]
+            child_path = f"{prefix}/{name}" if prefix else name
+            if child_is_dir:
+                child_end = walk(index, child_path, next_ancestors)
+                if child_end > end_index:
+                    raise FormatError("Nested GameCube FST directory exceeds parent")
+                index = child_end
+            else:
+                if value_a > image_size or value_b > image_size - value_a:
+                    raise FormatError(f"Disc file '{child_path}' is outside the image")
+                files.append(DiscFile(child_path, value_a, value_b))
+                index += 1
+        return end_index
+
+    if walk(0, "", frozenset()) != entry_count:
+        raise FormatError("GameCube FST traversal did not consume every entry")
+    return disc_id, files
+
+
+def decompress_yaz0(source: bytes) -> bytes:
+    if len(source) < 16 or source[:4] != b"Yaz0":
+        raise FormatError("Invalid Yaz0 header")
+    expanded_size = be32(source, 4)
+    if expanded_size == 0 or expanded_size > MAX_ARCHIVE_SIZE:
+        raise FormatError("Invalid Yaz0 expanded size")
+
+    output = bytearray(expanded_size)
+    src = 16
+    dst = 0
+    code = 0
+    bits_left = 0
+    while dst < expanded_size:
+        if bits_left == 0:
+            require_range(source, src, 1, "Yaz0 code")
+            code = source[src]
+            src += 1
+            bits_left = 8
+        if code & 0x80:
+            require_range(source, src, 1, "Yaz0 literal")
+            output[dst] = source[src]
+            src += 1
+            dst += 1
+        else:
+            require_range(source, src, 2, "Yaz0 back-reference")
+            first, second = source[src], source[src + 1]
+            src += 2
+            length = first >> 4
+            if length == 0:
+                require_range(source, src, 1, "Yaz0 long length")
+                length = source[src] + 0x12
+                src += 1
+            else:
+                length += 2
+            distance = ((first & 0x0F) << 8 | second) + 1
+            if distance > dst or length > expanded_size - dst:
+                raise FormatError("Invalid Yaz0 back-reference")
+            for _ in range(length):
+                output[dst] = output[dst - distance]
+                dst += 1
+        code = (code << 1) & 0xFF
+        bits_left -= 1
+    return bytes(output)
+
+
+def decompress_yay0(source: bytes) -> bytes:
+    if len(source) < 16 or source[:4] != b"Yay0":
+        raise FormatError("Invalid Yay0 header")
+    expanded_size = be32(source, 4)
+    links = be32(source, 8)
+    chunks = be32(source, 12)
+    if (
+        expanded_size == 0
+        or expanded_size > MAX_ARCHIVE_SIZE
+        or links >= len(source)
+        or chunks >= len(source)
+    ):
+        raise FormatError("Invalid Yay0 header")
+
+    output = bytearray(expanded_size)
+    mask_offset = 16
+    dst = 0
+    mask = 0
+    bits_left = 0
+    while dst < expanded_size:
+        if bits_left == 0:
+            mask = be32(source, mask_offset)
+            mask_offset += 4
+            bits_left = 32
+        if mask & 0x80000000:
+            require_range(source, chunks, 1, "Yay0 literal")
+            output[dst] = source[chunks]
+            chunks += 1
+            dst += 1
+        else:
+            token = be16(source, links)
+            links += 2
+            length = token >> 12
+            if length == 0:
+                require_range(source, chunks, 1, "Yay0 long length")
+                length = source[chunks] + 18
+                chunks += 1
+            else:
+                length += 2
+            distance = (token & 0x0FFF) + 1
+            if distance > dst or length > expanded_size - dst:
+                raise FormatError("Invalid Yay0 back-reference")
+            for _ in range(length):
+                output[dst] = output[dst - distance]
+                dst += 1
+        mask = (mask << 1) & 0xFFFFFFFF
+        bits_left -= 1
+    return bytes(output)
+
+
+def maybe_decompress(source: bytes) -> bytes:
+    if source.startswith(b"Yaz0"):
+        return decompress_yaz0(source)
+    if source.startswith(b"Yay0"):
+        return decompress_yay0(source)
+    return source
+
+
+def extract_rarc_file(archive: bytes, wanted_name: str) -> bytes:
+    archive = maybe_decompress(archive)
+    if len(archive) < 0x40 or archive[:4] != b"RARC":
+        raise FormatError("Stage archive is not RARC")
+
+    data_header = be32(archive, 8)
+    file_data = data_header + be32(archive, 0x0C)
+    if data_header < 0x20:
+        raise FormatError("Invalid RARC data-header offset")
+    require_range(archive, data_header, 0x20, "RARC data header")
+
+    entry_count = be32(archive, data_header + 8)
+    entry_table = data_header + be32(archive, data_header + 0x0C)
+    string_size = be32(archive, data_header + 0x10)
+    string_table = data_header + be32(archive, data_header + 0x14)
+    if entry_count > 1_000_000:
+        raise FormatError("Implausible RARC entry count")
+    require_range(archive, entry_table, entry_count * 0x14, "RARC entry table")
+    require_range(archive, string_table, string_size, "RARC string table")
+
+    wanted_folded = wanted_name.casefold()
+    for index in range(entry_count):
+        entry = entry_table + index * 0x14
+        type_and_name = be32(archive, entry + 4)
+        entry_type = type_and_name >> 24
+        if not entry_type & 0x01:  # RARCFileAttrType::FILE
+            continue
+        name_offset = type_and_name & 0x00FFFFFF
+        if name_offset >= string_size:
+            raise FormatError("Invalid RARC file-name offset")
+        name = bounded_c_string(
+            archive, string_table + name_offset, string_size - name_offset,
+            "RARC file name",
+        )
+        if name.casefold() != wanted_folded:
+            continue
+        data_offset = be32(archive, entry + 8)
+        data_size = be32(archive, entry + 0x0C)
+        absolute = file_data + data_offset
+        require_range(archive, absolute, data_size, "RARC file data")
+        return maybe_decompress(archive[absolute:absolute + data_size])
+    raise FormatError(f"RARC does not contain {wanted_name}")
+
+
+def actor_entry_size(tag: str) -> int | None:
+    if tag in {"ACTR", "TGOB"}:
+        return ACTOR_SIZE
+    if tag in {"TGSC", "SCOB"}:
+        return SCALED_ACTOR_SIZE
+    if len(tag) == 4 and tag[:3] == "ACT" and tag[3] in LAYER_CHARS:
+        return ACTOR_SIZE
+    if len(tag) == 4 and tag[:3] == "SCO" and tag[3] in LAYER_CHARS:
+        return SCALED_ACTOR_SIZE
+    return None
+
+
+def signed16(value: int) -> int:
+    return value - 0x10000 if value & 0x8000 else value
+
+
+def float_json(raw: bytes) -> float | str:
+    value = struct.unpack(">f", raw)[0]
+    if math.isfinite(value):
+        return value
+    return f"bits:0x{int.from_bytes(raw, 'big'):08x}"
+
+
+def fnv1a64(parts: Iterable[bytes]) -> int:
+    value = FNV_OFFSET_BASIS
+    for part in parts:
+        for byte in part:
+            value ^= byte
+            value = value * FNV_PRIME & 0xFFFFFFFFFFFFFFFF
+    return value
+
+
+def placement_key(
+    stage_id: int,
+    room: int,
+    canonical_name: str,
+    entry: bytes,
+    layer: str | None,
+) -> int:
+    name = canonical_name.encode("ascii").ljust(8, b"\0")
+    # D_SB05..D_SB09 reuse room archives for several unrelated grottos and
+    # select the destination with the actor layer. Elsewhere, identical actors
+    # across story layers represent the same physical prop and intentionally
+    # retain one persistent check.
+    layer_discriminator = (
+        int(layer, 16) if 35 <= stage_id <= 39 and layer is not None else 0xFF
+    )
+    return fnv1a64((
+        KEY_DOMAIN,
+        bytes((stage_id, room & 0xFF)),
+        name,
+        bytes((layer_discriminator,)),
+        entry[8:0x20],
+    ))
+
+
+def scan_dzs(
+    dzs: bytes,
+    *,
+    stage_id: int,
+    stage_name: str,
+    room: int,
+    archive_path: str,
+) -> list[dict[str, object]]:
+    require_range(dzs, 0, 4, "DZS header")
+    chunk_count = be32(dzs, 0)
+    if chunk_count > 4096:
+        raise FormatError("Implausible DZS chunk count")
+    require_range(dzs, 4, chunk_count * 12, "DZS chunk table")
+
+    placements: list[dict[str, object]] = []
+    for chunk_index in range(chunk_count):
+        node = 4 + chunk_index * 12
+        try:
+            tag = dzs[node:node + 4].decode("ascii")
+        except UnicodeDecodeError:
+            continue
+        entry_size = actor_entry_size(tag)
+        if entry_size is None:
+            continue
+        count = be32(dzs, node + 4)
+        data_offset = be32(dzs, node + 8)
+        if count > 1_000_000:
+            raise FormatError("Implausible DZS actor count")
+        require_range(dzs, data_offset, count * entry_size, "DZS actors")
+
+        layer = tag[3] if tag.startswith(("ACT", "SCO")) and tag not in {"ACTR", "SCOB"} else None
+        for actor_index in range(count):
+            offset = data_offset + actor_index * entry_size
+            entry = dzs[offset:offset + entry_size]
+            try:
+                name = entry[:8].split(b"\0", 1)[0].decode("ascii")
+            except UnicodeDecodeError:
+                continue
+            angle_z = be16(entry, 0x1C)
+            pot_type = (angle_z >> 1) & 0x1F
+            if name in CARRY_ACTORS and pot_type in POT_KEY_NAMES:
+                kind = "Pot"
+                canonical_name = POT_KEY_NAMES[pot_type]
+            elif name == "Pumpkin":
+                kind = "Pumpkin"
+                canonical_name = "Pumpkin"
+            else:
+                continue
+
+            key = placement_key(stage_id, room, canonical_name, entry, layer)
+            placements.append({
+                "key": f"{key:016x}",
+                "kind": kind,
+                "stage_id": stage_id,
+                "stage": stage_name,
+                "room": room,
+                "archive": archive_path,
+                "chunk": tag,
+                "layer": layer,
+                "actor_index": actor_index,
+                "actor": name,
+                "canonical_actor": canonical_name,
+                "pot_type": pot_type if kind == "Pot" else None,
+                "parameters": f"{be32(entry, 8):08x}",
+                "position": {
+                    "x": float_json(entry[0x0C:0x10]),
+                    "y": float_json(entry[0x10:0x14]),
+                    "z": float_json(entry[0x14:0x18]),
+                },
+                "rotation": {
+                    "x": signed16(be16(entry, 0x18)),
+                    "y": signed16(be16(entry, 0x1A)),
+                    "z": signed16(be16(entry, 0x1C)),
+                },
+                "set_id": be16(entry, 0x1E),
+                "source_entry_sha256": hashlib.sha256(entry).hexdigest(),
+            })
+    return placements
+
+
+def stage_archives(files: list[DiscFile]) -> list[tuple[DiscFile, int, str, int, str]]:
+    selected: list[tuple[DiscFile, int, str, int, str]] = []
+    room_pattern = re.compile(r"r([0-9]{2})_00\.arc", re.IGNORECASE)
+    for disc_file in files:
+        parts = disc_file.path.split("/")
+        folded = [part.casefold() for part in parts]
+        try:
+            res_index = next(
+                index for index in range(len(parts) - 2)
+                if folded[index:index + 2] == ["res", "stage"]
+            )
+        except StopIteration:
+            continue
+        if len(parts) != res_index + 4:
+            continue
+        stage_name = parts[res_index + 2]
+        stage_id = STAGE_IDS.get(stage_name.casefold())
+        if stage_id is None:
+            continue
+        archive_name = parts[res_index + 3]
+        if archive_name.casefold() == "stg_00.arc":
+            selected.append((disc_file, stage_id, STAGES[stage_id], -1, "stage.dzs"))
+            continue
+        match = room_pattern.fullmatch(archive_name)
+        if match:
+            selected.append((
+                disc_file, stage_id, STAGES[stage_id], int(match.group(1)), "room.dzr",
+            ))
+    selected.sort(key=lambda item: (item[1], item[3], item[0].path.casefold()))
+    return selected
+
+
+def inventory(image_path: Path) -> dict[str, object]:
+    image_size = image_path.stat().st_size
+    with image_path.open("rb") as image:
+        disc_id, files = read_fst(image, image_size)
+        archives = stage_archives(files)
+        if not archives:
+            raise FormatError("No Twilight Princess stage archives were found")
+
+        placements: list[dict[str, object]] = []
+        warnings: list[str] = []
+        for index, (disc_file, stage_id, stage_name, room, resource) in enumerate(archives, 1):
+            print(f"[{index:04d}/{len(archives):04d}] {disc_file.path}", file=sys.stderr)
+            if disc_file.size > MAX_ARCHIVE_SIZE:
+                warnings.append(f"Skipped oversized archive: {disc_file.path}")
+                continue
+            image.seek(disc_file.offset)
+            archive = image.read(disc_file.size)
+            if len(archive) != disc_file.size:
+                warnings.append(f"Short read: {disc_file.path}")
+                continue
+            try:
+                dzs = extract_rarc_file(archive, resource)
+                placements.extend(scan_dzs(
+                    dzs,
+                    stage_id=stage_id,
+                    stage_name=stage_name,
+                    room=room,
+                    archive_path=disc_file.path,
+                ))
+            except FormatError as error:
+                warnings.append(f"{disc_file.path}: {error}")
+
+    placements.sort(key=lambda item: (
+        item["kind"], item["stage_id"], item["room"], item["key"],
+        item["chunk"], item["actor_index"],
+    ))
+    key_counts: dict[str, int] = {}
+    for placement in placements:
+        key = str(placement["key"])
+        key_counts[key] = key_counts.get(key, 0) + 1
+    for placement in placements:
+        placement["identity_occurrences"] = key_counts[str(placement["key"])]
+
+    unique_keys = set(key_counts)
+    pot_keys = {str(item["key"]) for item in placements if item["kind"] == "Pot"}
+    pumpkin_keys = {str(item["key"]) for item in placements if item["kind"] == "Pumpkin"}
+    layered_keys = {str(item["key"]) for item in placements if item["layer"] is not None}
+    duplicated_keys = {key for key, count in key_counts.items() if count > 1}
+
+    return {
+        "schema": "tpr-breakable-placement-manifest-v2",
+        "source": {
+            "disc_id": disc_id,
+            "image_size": image_size,
+            "fst_file_count": len(files),
+            "stage_archive_count": len(archives),
+        },
+        "counts": {
+            "placement_records": len(placements),
+            "unique_runtime_keys": len(unique_keys),
+            "pot_keys": len(pot_keys),
+            "pumpkin_keys": len(pumpkin_keys),
+            "layered_keys": len(layered_keys),
+            "duplicated_runtime_keys": len(duplicated_keys),
+            "warnings": len(warnings),
+        },
+        "warnings": warnings,
+        "placements": placements,
+    }
+
+
+def write_summary(manifest: dict[str, object], output_path: Path) -> None:
+    source = manifest["source"]
+    counts = manifest["counts"]
+    lines = [
+        "# Twilight Princess Breakable Inventory",
+        "",
+        f"- Disc ID: `{source['disc_id']}`",
+        f"- Disc image size: `{source['image_size']}` bytes",
+        f"- Stage archives scanned: `{source['stage_archive_count']}`",
+        f"- Placement records: `{counts['placement_records']}`",
+        f"- Unique runtime keys: `{counts['unique_runtime_keys']}`",
+        f"- Pot keys: `{counts['pot_keys']}`",
+        f"- Pumpkin keys: `{counts['pumpkin_keys']}`",
+        f"- Keys from conditional layers: `{counts['layered_keys']}`",
+        f"- Duplicate runtime identities: `{counts['duplicated_runtime_keys']}`",
+        f"- Scan warnings: `{counts['warnings']}`",
+        "",
+        "This artifact contains placement metadata only; no game archives or executable data.",
+        "",
+    ]
+    output_path.write_text("\n".join(lines), encoding="utf-8")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("image", type=Path, help="Path to a raw GameCube disc image")
+    parser.add_argument("--output", type=Path, required=True, help="Output JSON manifest")
+    parser.add_argument("--summary", type=Path, help="Optional Markdown summary")
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    if not args.image.is_file():
+        print(f"error: disc image not found: {args.image}", file=sys.stderr)
+        return 2
+    try:
+        manifest = inventory(args.image)
+    except (OSError, FormatError) as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 1
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    if args.summary:
+        args.summary.parent.mkdir(parents=True, exist_ok=True)
+        write_summary(manifest, args.summary)
+    print(json.dumps(manifest["counts"], sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
