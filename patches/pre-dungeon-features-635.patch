+    void refresh_loaded_texture_overrides() noexcept {
+        try {
+            std::scoped_lock lock(tracked_texture_mutex());
+            bool changed = false;
+            for (auto& entry : tracked_texture_overrides()) {
+                if (entry.header == nullptr || entry.color == nullptr || entry.original.empty()) {
+                    continue;
+                }
+                u8* image = JSUConvertOffsetToPtr<u8>(
+                    entry.header, entry.header->imageOffset);
+                const auto& color = entry.color->getValue();
+                if (is_valid_hex_color_str(color)) {
+                    recolor_cmpr_texture_from_source(
+                        entry.header, hex_color_str_to_gx_color(color), entry.original.data());
+                } else {
+                    std::memcpy(image, entry.original.data(), entry.original.size());
+                }
+                changed = true;
+            }
+            if (changed) {
+                aurora::gx::clear_static_texture_cache();
+            }
+        } catch (...) {
+            // A cosmetic animation must never interrupt the renderer.
+        }
+    }
+
+    void forget_loaded_texture_overrides(JKRArchive* archive) noexcept {
+        if (archive == nullptr) {
+            return;
+        }
+        std::scoped_lock lock(tracked_texture_mutex());
+        auto& tracked = tracked_texture_overrides();
+        std::erase_if(tracked, [archive](const TrackedTextureOverride& entry) {
+            return entry.archive == archive;
+        });
+    }
+
+    void clear_loaded_texture_overrides() noexcept {
+        std::scoped_lock lock(tracked_texture_mutex());
+        tracked_texture_overrides().clear();
+    }
+}
