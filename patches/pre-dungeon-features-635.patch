+void randomize_colors_for_load_screen() noexcept {
+    try {
+        auto& values = getSettings().cosmetics;
+        if (!values.randomizeAllColorsEveryLoad.getValue()) {
+            update_runtime_cosmetics_impl(true);
+            return;
+        }
+
+        // Every-load is the safe winner if an older or hand-edited config has
+        // both master modes enabled. Normalize the persisted config once so
+        // the UI and subsequent launches agree with that precedence rule.
+        if (values.randomizeAllColorsPerSeed.getValueForSave()) {
+            values.randomizeAllColorsPerSeed.setValue(false);
+            config::save();
+        }
+
+        // Mix two clocks with a process-local transition counter. This avoids
+        // depending on std::random_device support in a UWP runtime, while the
+        // counter guarantees consecutive loads never receive the same input.
+        // No seed hash is involved: this mode is deliberately nondeterministic.
+        const auto steady = static_cast<std::uint64_t>(
+            std::chrono::steady_clock::now().time_since_epoch().count());
+        const auto wall = static_cast<std::uint64_t>(
+            std::chrono::system_clock::now().time_since_epoch().count());
+        const std::uint64_t transition =
+            load_transition_counter().fetch_add(1, std::memory_order_relaxed) + 1;
+        std::seed_seq seed{
+            static_cast<std::uint32_t>(steady),
+            static_cast<std::uint32_t>(steady >> 32),
+            static_cast<std::uint32_t>(wall),
+            static_cast<std::uint32_t>(wall >> 32),
+            static_cast<std::uint32_t>(transition),
+            static_cast<std::uint32_t>(transition >> 32),
+        };
+        std::mt19937_64 rng(seed);
+        std::uniform_int_distribution<std::size_t> midnaDist(0, kMidnaRainbow.size() - 1);
+
+        for (const auto& target : color_targets()) {
+            const std::string next = target.palette == ColorTarget::Palette::MidnaHair
+                ? std::string(kMidnaRainbow[midnaDist(rng)])
+                : color_from_hash_value(rng(), *target.option);
+            target.option->setRuntimeValue(next);
+        }
+
+        auto& state = runtime_color_state();
+        state.everyLoadPaletteActive = true;
+        state.rainbowIndex = std::numeric_limits<std::size_t>::max();
+        finish_runtime_color_change();
+    } catch (...) {
+        // A failed cosmetic roll must not block an area transition.
+    }
+}
+
+void update_runtime_cosmetics() noexcept {
+    update_runtime_cosmetics_impl(false);
+}
+
+void refresh_runtime_cosmetics() noexcept {
+    update_runtime_cosmetics_impl(true);
+}
+
+void clear_runtime_cosmetics() noexcept {
+    try {
+        clear_runtime_color_values();
+        auto& state = runtime_color_state();
+        state.everyLoadPaletteActive = false;
+        state.rainbowIndex = std::numeric_limits<std::size_t>::max();
+        finish_runtime_color_change();
+    } catch (...) {
+        // Cosmetics cleanup must be safe during shutdown and scene teardown.
+    }
+}
