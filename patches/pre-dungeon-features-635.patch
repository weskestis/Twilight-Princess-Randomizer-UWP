+bool save_set_builtin_blob(std::string_view name, const void* data, size_t size) {
+    if (s_currentSlot < 0 || name.empty() || name.size() > kMaxBlobNameLength ||
+        (data == nullptr && size != 0) || size > SAVE_BLOB_BUDGET_BYTES) {
+        return false;
+    }
+    load_sidecar();
+    auto& blobs = s_slots[static_cast<size_t>(s_currentSlot)]
+                      .mods[std::string(kBuiltinOwnerId)];
+    size_t total = size;
+    for (const auto& [blobName, bytes] : blobs) {
+        if (blobName != name) {
+            total += bytes.size();
+        }
+    }
+    if (total > SAVE_BLOB_BUDGET_BYTES) {
+        Log.error("built-in save blob '{}' exceeds the {}-byte budget", name,
+                  SAVE_BLOB_BUDGET_BYTES);
+        return false;
+    }
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    if (size == 0) {
+        blobs[std::string(name)].clear();
+    } else {
+        blobs[std::string(name)] = std::vector<uint8_t>(bytes, bytes + size);
+    }
+    return true;
+}
+
+std::optional<std::vector<uint8_t>> save_get_builtin_blob(std::string_view name) {
+    if (s_currentSlot < 0 || name.empty()) {
+        return std::nullopt;
+    }
+    load_sidecar();
+    const auto& mods = s_slots[static_cast<size_t>(s_currentSlot)].mods;
+    const auto owner = mods.find(std::string(kBuiltinOwnerId));
+    if (owner == mods.end()) {
+        return std::nullopt;
+    }
+    const auto blob = owner->second.find(std::string(name));
+    return blob == owner->second.end() ? std::nullopt
+                                       : std::optional<std::vector<uint8_t>>(blob->second);
+}
+
+int32_t save_current_slot() {
+    return s_currentSlot;
+}
+
+uint64_t save_state_revision() {
+    return s_saveStateRevision;
