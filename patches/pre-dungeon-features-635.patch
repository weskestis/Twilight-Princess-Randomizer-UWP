+    void ImGuiMenuRandomizer::refreshTrackerDataIfNeeded(bool force) {
+        if (!randomizer_IsActive()) {
+            return;
+        }
+
+        auto* trackerRando = getTrackerRando();
+        const auto& contextHash = randomizer_GetContext().mHash;
+        const auto trackerHash = trackerRando->GetConfig().GetHash(false);
+        const bool worldNeedsReload = trackerHash.empty() ||
+            (trackerHash != contextHash && !contextHash.empty());
+        if (!force && !g_randomizerState.mUpdateTracker && !worldNeedsReload) {
+            return;
+        }
+        if (!force && !m_trackerError.empty() && m_trackerErrorHash == contextHash) {
+            g_randomizerState.mUpdateTracker = false;
+            return;
+        }
+
+        g_randomizerState.mUpdateTracker = false;
+        try {
+            if (worldNeedsReload) {
+                *trackerRando = randomizer::Randomizer(ui::GetRandomizerPath());
+                trackerRando->GenerateTrackerWorld();
+            }
+
+            if (!trackerRando->GetConfig().GetHash(false).empty()) {
+                auto currentItems = getSaveItemPool(trackerRando->GetWorld());
+                m_currentInventory = currentItems;
+                m_currentSearch = randomizer::logic::search::Search::AccessibleNoStartingInventory(
+                    &trackerRando->GetWorlds(), currentItems);
+                m_currentSearch.SearchWorlds();
+                generateLocationInfo();
+            }
+            m_trackerError.clear();
+            m_trackerErrorHash.clear();
+        } catch (const std::exception& error) {
+            m_trackerError = error.what();
+            m_trackerErrorHash = contextHash;
+            *trackerRando = randomizer::Randomizer(ui::GetRandomizerPath());
+            m_currentInventory.clear();
+            m_LocationInfo.clear();
+            DuskLog.error("Tracker refresh failed safely for seed '{}': {}",
+                contextHash, m_trackerError);
+        } catch (...) {
+            m_trackerError = "Unknown tracker error";
+            m_trackerErrorHash = contextHash;
+            *trackerRando = randomizer::Randomizer(ui::GetRandomizerPath());
+            m_currentInventory.clear();
+            m_LocationInfo.clear();
+            DuskLog.error("Tracker refresh failed safely for seed '{}'", contextHash);
+        }
+    }
