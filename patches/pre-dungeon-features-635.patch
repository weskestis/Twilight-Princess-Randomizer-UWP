+
+namespace randomizer::breakables {
+
+// Authored from the verified GZ2E01 placement inventory. Keeping this static
+// makes seed generation deterministic and avoids rescanning hundreds of disc
+// archives every time a seed is generated.
+std::vector<Definition> load_breakable_definitions();
+
+}  // namespace randomizer::breakables
