diff --git a/cmake/PatchFunchook.cmake b/cmake/PatchFunchook.cmake
index a32c291ee..5f18d66bd 100644
--- a/cmake/PatchFunchook.cmake
+++ b/cmake/PatchFunchook.cmake
@@ -103,3 +103,35 @@ if (NOT _windows_content MATCHES "DUSK_UWP_MODULE_BASE")
 #endif]=] _windows_content "${_windows_content}")
     file(WRITE "${SOURCE_DIR}/src/funchook_windows.c" "${_windows_content}")
 endif ()
+
+# Windows Store JIT pages must remain W^X: VirtualProtectFromApp rejects simultaneous write and
+# execute access. Funchook already creates its trampoline pages writable, fills them, and then
+# makes them executable, so route those transitions through the AppContainer APIs and make the
+# short target-patch window writable (not RWX). The package declares codeGeneration.
+if (NOT _windows_content MATCHES "DUSK_UWP_WX_MEMORY")
+    set(_internal_include "#include \"funchook_internal.h\"")
+    string(FIND "${_windows_content}" "${_internal_include}" _internal_include_position)
+    if (_internal_include_position EQUAL -1)
+        message(FATAL_ERROR "Funchook internal include site changed")
+    endif ()
+    string(REPLACE "${_internal_include}" [=[#include "funchook_internal.h"
+#if defined(DUSK_UWP)
+#define DUSK_UWP_WX_MEMORY 1
+#define VirtualAlloc VirtualAllocFromApp
+#define VirtualProtect VirtualProtectFromApp
+#define FUNCHOOK_TARGET_WRITE_PROTECTION PAGE_READWRITE
+#else
+#define FUNCHOOK_TARGET_WRITE_PROTECTION PAGE_EXECUTE_READWRITE
+#endif]=] _windows_content "${_windows_content}")
+
+    set(_target_unprotect
+        "    ok = VirtualProtect(mstate->addr, mstate->size, PAGE_EXECUTE_READWRITE, &mstate->protect);")
+    string(FIND "${_windows_content}" "${_target_unprotect}" _target_unprotect_position)
+    if (_target_unprotect_position EQUAL -1)
+        message(FATAL_ERROR "Funchook target protection site changed")
+    endif ()
+    string(REPLACE "${_target_unprotect}"
+        "    ok = VirtualProtect(mstate->addr, mstate->size, FUNCHOOK_TARGET_WRITE_PROTECTION, &mstate->protect);"
+        _windows_content "${_windows_content}")
+    file(WRITE "${SOURCE_DIR}/src/funchook_windows.c" "${_windows_content}")
+endif ()
