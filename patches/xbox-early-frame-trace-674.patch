+    detail::traceEnabled.store(true, std::memory_order_relaxed);
     detail::activityActive = true;
     detail::activityAwaitingFrame = false;
+    detail::activityFramesRemaining = 0;
     if (!detail::recoveryMode) {
         detail::write_locked(value);
     }
