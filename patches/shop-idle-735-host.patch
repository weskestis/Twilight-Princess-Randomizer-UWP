+#if defined(_UWP)
+// Private static-feed bridge. Keep the public FlowService ABI unchanged.
+// A message control owns this immutable copy until its normal reset/destructor
+// releases the binding; another shelf's string cannot invalidate its pointers.
+extern "C" const char* tpr_xbox_retain_shop_text(
+    void* owner, const char* text, size_t size) noexcept {
+    if (owner == nullptr || text == nullptr || size == 0 || size > 8192) {
+        return nullptr;
+    }
+    try {
+        auto owned = std::make_shared<std::vector<uint8_t>>(text, text + size);
+        owned->push_back(0);
+        const auto* result = reinterpret_cast<const char*>(owned->data());
+        retain_binding(static_cast<JMessage::TControl*>(owner), nullptr, nullptr, owned);
+        return result;
+    } catch (...) {
+        return nullptr;
+    }
+}
+#endif
