+    auto& loader = mods::ModLoader::instance();
+    auto* mod = loader.find_mod(mSelectedModId);
+    if (!mod || !mDetailDelay.take(mod->metadata.id, loader.generation(),
+                                  mod->cacheGeneration, ModPanelDelay::Clock::now(), force)) return;
+    auto* pane = mPendingDetailPane; mPendingDetailPane = nullptr;
+    mSelectedMod = mod;
+    pane->clear();
+    build_detail(*pane, *mod);
+    if (force && mDocument) mDocument->UpdateDocument();
+}
