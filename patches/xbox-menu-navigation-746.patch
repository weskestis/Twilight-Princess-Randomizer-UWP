+class ModListPane final : public Pane {
+public:
+    explicit ModListPane(Rml::Element* parent) : Pane(parent, Type::Controlled) {}
+
+    void update() override {
+        const float viewTop = mRoot->GetAbsoluteOffset(Rml::BoxArea::Border).y;
+        const float viewHeight = mRoot->GetClientHeight();
+        const float margin = viewHeight * 0.25f;
+        auto* context = mRoot->GetContext();
+        auto* focused = context ? context->GetFocusElement() : nullptr;
+        for (const auto& child : mChildren) {
+            if (auto* entry = dynamic_cast<ModListEntry*>(child.get()); entry && viewHeight > 0) {
+                const float top = entry->root()->GetAbsoluteOffset(Rml::BoxArea::Border).y - viewTop;
+                const bool nearby = top + entry->root()->GetOffsetHeight() >= -margin &&
+                                    top <= viewHeight + margin;
+                entry->set_culled(!nearby && !entry->contains(focused));
+            }
+            child->update();
+        }
+    }
+};
