+          mPreviewPending(std::move(previewPending)) {}
+    void update() override {
+        // Native controls from the previous preview do not need to poll while
+        // the user is scrolling to another mod.
+        if (!mPreviewPending()) Pane::update();
+    }
+    bool focus() override {
+        mBeforeFocus();
+        return Pane::focus();
+    }
+private:
+    std::function<void()> mBeforeFocus;
+    std::function<bool()> mPreviewPending;
 };
 
