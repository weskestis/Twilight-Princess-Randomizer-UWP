diff --git a/src/dusk/ui/xbox_file_picker.cpp b/src/dusk/ui/xbox_file_picker.cpp
new file mode 100644
index 0000000..48e48a6
--- /dev/null
+++ b/src/dusk/ui/xbox_file_picker.cpp
@@ -0,0 +1,352 @@
+#include "xbox_file_picker.hpp"
+#include "xbox_file_picker_model.hpp"
+
+#include "dusk/data.hpp"
+#include "list.hpp"
+#include "modal.hpp"
+#include "ui.hpp"
+
+#include <borealis/file_select.hpp>
+#include <borealis/io.hpp>
+#include <SDL3/SDL_log.h>
+
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+// Use the same checked, staged writer as the other Borealis export backends.
+namespace borealis::file_select::detail {
+Result copy_export_file(std::string_view, std::string_view, bool);
+}
+
+namespace dusk::ui::xbox_file_picker {
+namespace {
+namespace select = borealis::file_select;
+enum class Kind { File, Folder, Export };
+struct Request {
+    Kind kind = Kind::File;
+    select::Callback callback;
+    std::vector<select::Filter> filters;
+    std::vector<std::string> roots;
+    std::string initialLocation;
+    std::string source;
+    std::string suggestedName;
+    std::string exportDestination;
+    std::optional<select::Result> terminal;
+    bool shown = false;
+    bool closed = false;
+    bool confirming = false;
+};
+std::shared_ptr<Request> g_request;
+
+struct ListingJob {
+    std::mutex mutex;
+    std::atomic_bool canceled = false;
+    std::optional<model::Listing> result;
+};
+struct ExportJob {
+    std::mutex mutex;
+    std::optional<select::Result> result;
+};
+
+class Browser final : public Modal {
+public:
+    explicit Browser(std::shared_ptr<Request> request)
+        : Modal(props(request)), mRequest(std::move(request)) {
+        mDialog->SetProperty("width", "90vw");
+        mDialog->SetProperty("max-width", "90vw");
+        mDialog->SetProperty("max-height", "90vh");
+        mDialog->QuerySelector("modal-body")->SetProperty("white-space", "pre-wrap");
+        auto& pane = content_pane();
+        mList = &pane.add_child<List>(List::Props{
+            .onPressed = [this](uint64_t key) { mPendingKey = key; },
+            .isDisabled = [this](uint64_t) { return blocked(); },
+        });
+        mList->root()->SetProperty("height", "48vh");
+        mList->root()->SetProperty("overflow-y", "auto");
+        navigate(mRequest->initialLocation);
+    }
+    ~Browser() override {
+        if (mListingJob) mListingJob->canceled.store(true);
+        if (!mRequest->terminal) mRequest->terminal = select::Result{.status = select::Status::Canceled};
+        mRequest->closed = true;
+    }
+    void update() override {
+        try {
+            if (mListingJob) {
+                std::optional<model::Listing> result;
+                {
+                    std::lock_guard lock(mListingJob->mutex);
+                    result.swap(mListingJob->result);
+                }
+                if (result) {
+                    mListingJob.reset();
+                    mListing = std::move(*result);
+                    display_page();
+                }
+            }
+            if (mExportJob) {
+                std::optional<select::Result> result;
+                {
+                    std::lock_guard lock(mExportJob->mutex);
+                    result.swap(mExportJob->result);
+                }
+                if (result) {
+                    mExportJob.reset();
+                    finish(std::move(*result));
+                }
+            }
+            if (!mRequest->exportDestination.empty() && !mExportJob) {
+                start_export(std::exchange(mRequest->exportDestination, {}));
+            }
+            if (auto key = std::exchange(mPendingKey, {})) activate(*key);
+            Modal::update();
+        } catch (const std::exception& exception) {
+            finish({.status = select::Status::Failed, .message = exception.what()});
+        } catch (...) {
+            finish({.status = select::Status::Failed, .message = "The Xbox file browser could not complete this action."});
+        }
+    }
+protected:
+    bool handle_nav_command(Rml::Event& event, NavCommand command) override {
+        if (mExportJob && (command == NavCommand::Cancel || command == NavCommand::Menu)) return true;
+        return Modal::handle_nav_command(event, command);
+    }
+private:
+    static Browser& browser(Modal& modal) { return static_cast<Browser&>(modal); }
+    static Props props(const std::shared_ptr<Request>& request) {
+        Props props;
+        props.title = request->kind == Kind::File ? "Select File" :
+                      request->kind == Kind::Folder ? "Select Data Folder" : "Export File";
+        props.bodyText = "Reading folders...";
+        props.actions = {
+            {.label = "Locations", .onPressed = [](Modal& m) { browser(m).navigate({}); },
+                .isDisabled = [] { return g_request && (g_request->terminal || g_request->confirming); }},
+            {.label = "Parent", .onPressed = [](Modal& m) { browser(m).parent(); }},
+            {.label = "Previous", .onPressed = [](Modal& m) { browser(m).page(-1); }},
+            {.label = "Next", .onPressed = [](Modal& m) { browser(m).page(1); }},
+        };
+        if (request->kind == Kind::File && request->filters.size() > 1) {
+            props.actions.push_back({.label = "File Type", .onPressed = [](Modal& m) { browser(m).next_filter(); }});
+        }
+        if (request->kind != Kind::File) {
+            props.actions.push_back({.label = request->kind == Kind::Folder ? "Choose Folder" : "Export Here",
+                .onPressed = [](Modal& m) { browser(m).choose_folder(); }});
+        }
+        props.actions.push_back({.label = "Cancel", .onPressed = [](Modal& m) { browser(m).cancel(); }});
+        props.onDismiss = [](Modal& m) { browser(m).cancel(); };
+        return props;
+    }
+    bool blocked() const { return mRequest->terminal.has_value() || mExportJob || mRequest->confirming; }
+    void finish(select::Result result) {
+        if (mRequest->terminal) return;
+        mRequest->terminal = std::move(result);
+        if (mListingJob) mListingJob->canceled.store(true);
+        pop();
+    }
+    void cancel() {
+        if (!mExportJob) finish({.status = select::Status::Canceled});
+    }
+    void navigate(std::string location) {
+        if (blocked()) return;
+        if (mListingJob) mListingJob->canceled.store(true);
+        mLocation = std::move(location);
+        ++mGeneration;
+        mPendingKey.reset();
+        mPage = 0;
+        mListing = {};
+        mList->set_items({});
+        set_body_text((mLocation.empty() ? "Available locations" : mLocation) + "\nReading folders...");
+        auto job = std::make_shared<ListingJob>();
+        mListingJob = job;
+        std::string pattern = mRequest->filters.empty() ? "*" : mRequest->filters[mFilter].pattern;
+        // The worker owns its result, never a document, element, or callback.
+        std::thread([job, location = mLocation, roots = mRequest->roots,
+                        pattern = std::move(pattern), foldersOnly = mRequest->kind != Kind::File] {
+            auto listing = model::scan(location, roots, pattern, foldersOnly, job->canceled);
+            if (job->canceled.load()) return;
+            std::lock_guard lock(job->mutex);
+            job->result = std::move(listing);
+        }).detach();
+    }
+    void display_page() {
+        constexpr size_t pageSize = 200;
+        std::vector<List::Item> items;
+        size_t first = mPage * pageSize;
+        size_t last = std::min(first + pageSize, mListing.entries.size());
+        for (size_t index = first; index < last; ++index) {
+            const auto& entry = mListing.entries[index];
+            items.push_back({(uint64_t{mGeneration} << 32) | (index + 1),
+                (entry.directory ? "[Folder] " : "") + entry.label});
+        }
+        mList->set_items(std::move(items));
+        auto body = mLocation.empty() ? std::string{"Available locations (app storage and accessible drives)"} : mLocation;
+        if (mRequest->kind == Kind::File && !mRequest->filters.empty()) body += "\n" + mRequest->filters[mFilter].name;
+        if (mRequest->kind == Kind::Export) body += "\nExport: " + mRequest->suggestedName;
+        if (!mListing.error.empty()) body += "\n" + mListing.error;
+        else if (mListing.entries.empty()) body += "\nNo matching entries. Use Locations, Parent, or File Type.";
+        if (mListing.entries.size() > pageSize) body += "\nPage " + std::to_string(mPage + 1) + " of " +
+            std::to_string((mListing.entries.size() + pageSize - 1) / pageSize);
+        set_body_text(body);
+        if (top_document() == this) focus();
+    }
+    void activate(uint64_t key) {
+        if (blocked() || mListingJob || (key >> 32) != mGeneration) return;
+        auto index = static_cast<uint32_t>(key) - 1;
+        if (index >= mListing.entries.size()) return;
+        const auto entry = mListing.entries[index];
+        if (entry.directory) navigate(entry.location);
+        else finish({.status = select::Status::Selected, .locations = {entry.location}});
+    }
+    void parent() {
+        if (blocked() || mLocation.empty()) return;
+        auto parent = model::path(mLocation).parent_path();
+        navigate(parent == model::path(mLocation) ? std::string{} : model::utf8(parent));
+    }
+    void page(int direction) {
+        if (blocked() || mListingJob) return;
+        if (direction < 0 && mPage > 0) --mPage;
+        else if (direction > 0 && (mPage + 1) * 200 < mListing.entries.size()) ++mPage;
+        else return;
+        ++mGeneration;
+        mPendingKey.reset();
+        display_page();
+    }
+    void next_filter() {
+        if (blocked() || mRequest->filters.empty()) return;
+        mFilter = (mFilter + 1) % mRequest->filters.size();
+        navigate(mLocation);
+    }
+    void choose_folder() {
+        if (blocked() || mListingJob || mLocation.empty() || !mListing.usable) return;
+        if (mRequest->kind == Kind::Folder) {
+            finish({.status = select::Status::Selected, .locations = {mLocation}});
+            return;
+        }
+        auto destination = model::path(mLocation) / model::path(mRequest->suggestedName);
+        std::error_code error;
+        const bool exists = std::filesystem::exists(destination, error);
+        if (error) {
+            set_body_text(mLocation + "\nCannot check the destination: " + error.message());
+            return;
+        }
+        if (!exists) {
+            start_export(model::utf8(destination));
+            return;
+        }
+        mRequest->confirming = true;
+        std::weak_ptr<Request> weak = mRequest;
+        auto cancelConfirmation = [weak](Modal& modal) {
+            if (auto request = weak.lock()) request->confirming = false;
+            modal.pop();
+        };
+        push_document(std::make_unique<Modal>(Modal::Props{
+            .title = "Replace Existing File?", .bodyText = model::utf8(destination),
+            .actions = {
+                {.label = "Replace", .onPressed = [weak, destination = model::utf8(destination)](Modal& modal) {
+                    if (auto request = weak.lock(); request && !request->terminal) {
+                        request->confirming = false;
+                        request->exportDestination = destination;
+                    }
+                    modal.pop();
+                }},
+                {.label = "Cancel", .onPressed = cancelConfirmation},
+            }, .onDismiss = cancelConfirmation,
+        }));
+    }
+    void start_export(std::string destination) {
+        if (blocked()) return;
+        set_body_text("Exporting " + mRequest->suggestedName + "...");
+        auto job = std::make_shared<ExportJob>();
+        mExportJob = job;
+        std::thread([job, source = mRequest->source, destination = std::move(destination)] {
+            auto result = select::detail::copy_export_file(source, destination, true);
+            std::lock_guard lock(job->mutex);
+            job->result = std::move(result);
+        }).detach();
+    }
+    std::shared_ptr<Request> mRequest;
+    List* mList = nullptr;
+    std::shared_ptr<ListingJob> mListingJob;
+    std::shared_ptr<ExportJob> mExportJob;
+    model::Listing mListing;
+    std::string mLocation;
+    std::optional<uint64_t> mPendingKey;
+    uint32_t mGeneration = 0;
+    size_t mPage = 0;
+    size_t mFilter = 0;
+};
+
+void start(std::shared_ptr<Request> request, std::string defaultLocation) {
+    if (g_request) throw std::runtime_error("Another Xbox file browser is already open.");
+    const auto configured = borealis::io::fs_path_to_string(data::configured_data_path());
+    request->roots.push_back(configured);
+    if (!defaultLocation.empty()) {
+        // File defaults become their parent folder. No disk access on the UI thread.
+        auto candidate = model::path(defaultLocation);
+        if (request->kind == Kind::File && candidate.has_extension()) candidate = candidate.parent_path();
+        request->initialLocation = model::utf8(candidate);
+        request->roots.push_back(request->initialLocation);
+    }
+    g_request = std::move(request);
+}
+void open_file(select::FileOptions options, select::Callback callback) {
+    auto request = std::make_shared<Request>();
+    request->callback = std::move(callback);
+    request->filters = std::move(options.filters);
+    start(std::move(request), std::move(options.defaultLocation));
+}
+void open_folder(select::FolderOptions options, select::Callback callback) {
+    auto request = std::make_shared<Request>();
+    request->kind = Kind::Folder;
+    request->callback = std::move(callback);
+    start(std::move(request), std::move(options.defaultLocation));
+}
+void export_file(select::ExportOptions options, select::Callback callback) {
+    auto request = std::make_shared<Request>();
+    request->kind = Kind::Export;
+    request->callback = std::move(callback);
+    request->source = std::move(options.sourceLocation);
+    request->suggestedName = std::move(options.suggestedName);
+    const auto configured = borealis::io::fs_path_to_string(data::configured_data_path());
+    start(std::move(request), configured);
+}
+}  // namespace
+
+void initialize() noexcept {
+    select::install_platform_backend({&open_file, &open_folder, &export_file});
+}
+void update() noexcept {
+    try {
+        select::pump_completions();
+        if (!g_request) return;
+        if (g_request->closed) {
+            // Deliver after the browser has been removed, outside document iteration.
+            auto request = std::exchange(g_request, {});
+            request->callback(request->terminal.value_or(select::Result{.status = select::Status::Canceled}));
+        } else if (!g_request->shown) {
+            auto browser = std::make_unique<Browser>(g_request);
+            g_request->shown = true;
+            push_document(std::move(browser));
+        }
+    } catch (const std::exception& exception) {
+        auto request = std::exchange(g_request, {});
+        if (request) request->callback({.status = select::Status::Failed, .message = exception.what()});
+    } catch (...) {
+        auto request = std::exchange(g_request, {});
+        if (request) request->callback({.status = select::Status::Failed, .message = "Unable to open the Xbox file browser."});
+    }
+}
+void shutdown() noexcept {
+    auto request = std::exchange(g_request, {});
+    if (request && request->callback) {
+        request->terminal = select::Result{.status = select::Status::Canceled};
+        request->callback(*request->terminal);
+    }
+    select::pump_completions();
+    select::install_platform_backend({});
+}
+}  // namespace dusk::ui::xbox_file_picker
