+++ b/src/dusk/ui/xbox_file_picker_model.hpp
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <exception>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace dusk::ui::xbox_file_picker::model {
+namespace fs = std::filesystem;
+
+struct Entry {
+    std::string location;
+    std::string label;
+    bool directory = false;
+};
+struct Listing {
+    std::vector<Entry> entries;
+    std::string error;
+    bool usable = false;
+};
+
+inline std::string utf8(const fs::path& path) {
+    auto value = path.u8string();
+    return {reinterpret_cast<const char*>(value.data()), value.size()};
+}
+inline fs::path path(std::string_view value) {
+    return fs::u8path(value.begin(), value.end());
+}
+inline std::string lower(std::string value) {
+    for (auto& c : value) {
+        if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    }
+    return value;
+}
+inline bool matches(const fs::path& filename, std::string_view pattern) {
+    if (pattern.empty() || pattern == "*") return true;
+    auto extension = lower(utf8(filename.extension()));
+    if (!extension.empty() && extension.front() == '.') extension.erase(0, 1);
+    while (!pattern.empty()) {
+        auto separator = pattern.find(';');
+        auto token = pattern.substr(0, separator);
+        if (token == "*" || lower(std::string{token}) == extension) return true;
+        if (separator == std::string_view::npos) break;
+        pattern.remove_prefix(separator + 1);
+    }
+    return false;
+}
+inline void sort(Listing& listing) {
+    std::sort(listing.entries.begin(), listing.entries.end(), [](const Entry& a, const Entry& b) {
+        if (a.directory != b.directory) return a.directory;
+        auto al = lower(a.label), bl = lower(b.label);
+        return al == bl ? a.location < b.location : al < bl;
+    });
+}
+inline Listing scan(const std::string& location, const std::vector<std::string>& roots,
+    std::string_view pattern, bool foldersOnly, const std::atomic_bool& canceled) {
+    Listing listing;
+    try {
+        if (location.empty()) {
+            auto add = [&](const fs::path& candidate) {
+                std::error_code error;
+                if (canceled.load() || !fs::is_directory(candidate, error) || error) return;
+                auto name = utf8(candidate.lexically_normal());
+                if (std::any_of(listing.entries.begin(), listing.entries.end(), [&](const Entry& entry) {
+                    return lower(entry.location) == lower(name);
+                })) return;
+                listing.entries.push_back({name, name, true});
+            };
+            for (const auto& root : roots) add(path(root));
+#if defined(_WIN32)
+            // Xbox mounts and USB drive letters are probed off the UI thread.
+            for (char drive = 'C'; drive <= 'Z' && !canceled.load(); ++drive) {
+                add(path(std::string(1, drive) + ":\\"));
+            }
+#endif
+            listing.usable = true;
+        } else {
+            std::error_code error;
+            fs::directory_iterator iterator(path(location), fs::directory_options::none, error);
+            if (error) {
+                listing.error = "Cannot read this folder: " + error.message();
+                return listing;
+            }
+            listing.usable = true;
+            for (const fs::directory_iterator end; iterator != end && !canceled.load(); iterator.increment(error)) {
+                if (error) break;
+                const auto& entry = *iterator;
+                std::error_code statusError;
+                const bool directory = entry.is_directory(statusError);
+                if (statusError) continue;
+                if (!directory && (foldersOnly || !entry.is_regular_file(statusError) || statusError ||
+                                      !matches(entry.path().filename(), pattern))) continue;
+                listing.entries.push_back({utf8(entry.path()), utf8(entry.path().filename()), directory});
+                if (listing.entries.size() >= 65536) {
+                    listing.error = "This folder has too many entries. Move the desired file to a smaller folder.";
+                    break;
+                }
+            }
+            if (error) listing.error = "Some entries could not be read: " + error.message();
+        }
+        sort(listing);
+    } catch (const std::exception& exception) {
+        listing.usable = false;
+        listing.error = exception.what();
+    } catch (...) {
+        listing.usable = false;
+        listing.error = "Unable to read this folder.";
+    }
+    return listing;
+}
+}  // namespace dusk::ui::xbox_file_picker::model
