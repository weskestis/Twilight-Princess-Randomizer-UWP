+
+namespace dusk::ui {
+namespace {
+
+enum class MenuRole : std::size_t {
+    Accent,
+    Background,
+    Text,
+    Border,
+    Count,
+};
+
+constexpr std::size_t kRoleCount = static_cast<std::size_t>(MenuRole::Count);
+constexpr std::uint8_t kAllRoles = (1u << kRoleCount) - 1u;
+constexpr std::string_view kThemeId = "tpr-user-menu-theme";
+
+struct MenuPalette {
+    std::array<std::string, kRoleCount> colors;
+};
+
+constexpr std::array<std::array<std::string_view, kRoleCount>, 8> kSafePalettes{{
+    {{"c2a42d", "151610", "e0dbc8", "92875b"}},
+    {{"4da3ff", "0b1520", "e8f2ff", "6b9bc4"}},
+    {{"c084fc", "180d22", "f7eaff", "a875c2"}},
+    {{"5fd38d", "0b1a12", "e9fff1", "5fa77a"}},
+    {{"ff7a72", "210d0c", "fff0ed", "c47a70"}},
+    {{"42d8cf", "091b1b", "e8ffff", "5faaa6"}},
+    {{"f0a34b", "20130a", "fff3df", "c18b56"}},
+    {{"f07bb4", "21101a", "ffeafa", "c3789d"}},
+}};
+
+struct Rgb {
+    int red = 0;
+    int green = 0;
+    int blue = 0;
+};
+
+struct RuntimeState {
+    std::string seedHash;
+    MenuPalette seedPalette;
+    MenuPalette loadPalette;
+    std::array<bool, kRoleCount> ownedOverrides{};
+    std::uint8_t seedMask = 0;
+    bool seedRainbow = false;
+    bool loadActive = false;
+    bool loadRainbow = false;
+    std::uint64_t rainbowFrame = std::numeric_limits<std::uint64_t>::max();
+};
+
+RuntimeState& runtime_state() {
+    static RuntimeState state;
+    return state;
+}
+
+std::array<ConfigVar<std::string>*, kRoleCount> color_vars() {
+    auto& settings = getSettings().cosmetics;
+    return {
+        &settings.menuAccentColor,
+        &settings.menuBackgroundColor,
+        &settings.menuTextColor,
+        &settings.menuBorderColor,
+    };
+}
+
+constexpr std::array<std::string_view, kRoleCount> kRoleLabels{
+    "Menu Accent Color",
+    "Menu Background Color",
+    "Menu Text Color",
+    "Menu Border Color",
+};
+
+int hex_nibble(char value) noexcept {
+    if (value >= '0' && value <= '9') {
+        return value - '0';
+    }
+    if (value >= 'a' && value <= 'f') {
+        return value - 'a' + 10;
+    }
+    if (value >= 'A' && value <= 'F') {
+        return value - 'A' + 10;
+    }
+    return -1;
+}
+
+bool parse_rgb(std::string_view value, Rgb& color) noexcept {
+    if (value.starts_with('#')) {
+        value.remove_prefix(1);
+    }
+    if (value.size() != 6) {
+        return false;
+    }
+    std::array<int, 6> digits{};
+    for (std::size_t i = 0; i < digits.size(); ++i) {
+        digits[i] = hex_nibble(value[i]);
+        if (digits[i] < 0) {
+            return false;
+        }
+    }
+    color = {
+        digits[0] * 16 + digits[1],
+        digits[2] * 16 + digits[3],
+        digits[4] * 16 + digits[5],
+    };
+    return true;
+}
+
+std::string normalize_color(std::string value) {
+    if (!value.empty() && value.front() == '#') {
+        value.erase(value.begin());
+    }
+    std::ranges::transform(value, value.begin(), [](unsigned char ch) {
+        return static_cast<char>(std::tolower(ch));
+    });
+    return value;
+}
+
+bool is_rainbow(std::string_view value) noexcept {
+    return value == "rainbow" || value == "Rainbow";
+}
+
+bool valid_color(std::string_view value) noexcept {
+    Rgb unused;
+    return parse_rgb(value, unused);
+}
+
+double linear_channel(int channel) noexcept {
+    const double value = static_cast<double>(channel) / 255.0;
+    return value <= 0.04045 ? value / 12.92 : std::pow((value + 0.055) / 1.055, 2.4);
+}
+
+double luminance(const Rgb& color) noexcept {
+    return 0.2126 * linear_channel(color.red) + 0.7152 * linear_channel(color.green) +
+           0.0722 * linear_channel(color.blue);
+}
+
+double contrast(const Rgb& first, const Rgb& second) noexcept {
+    const double a = luminance(first);
+    const double b = luminance(second);
+    return (std::max(a, b) + 0.05) / (std::min(a, b) + 0.05);
+}
+
+bool palette_readable(const MenuPalette& palette) noexcept {
+    std::array<Rgb, kRoleCount> rgb{};
+    for (std::size_t i = 0; i < kRoleCount; ++i) {
+        if (!parse_rgb(palette.colors[i], rgb[i])) {
+            return false;
+        }
+    }
+    const auto background = static_cast<std::size_t>(MenuRole::Background);
+    return contrast(rgb[static_cast<std::size_t>(MenuRole::Text)], rgb[background]) >= 4.5 &&
+           contrast(rgb[static_cast<std::size_t>(MenuRole::Accent)], rgb[background]) >= 3.0 &&
+           contrast(rgb[static_cast<std::size_t>(MenuRole::Border)], rgb[background]) >= 3.0;
+}
+
+MenuPalette palette_at(std::size_t index) {
+    MenuPalette result;
+    const auto& source = kSafePalettes[index % kSafePalettes.size()];
+    for (std::size_t i = 0; i < kRoleCount; ++i) {
+        result.colors[i] = source[i];
+    }
+    return result;
+}
+
+MenuPalette default_palette() {
+    return palette_at(0);
+}
+
+MenuPalette saved_palette() {
+    auto palette = default_palette();
+    const auto vars = color_vars();
+    for (std::size_t i = 0; i < vars.size(); ++i) {
+        const std::string value = normalize_color(vars[i]->getValueForSave());
+        if (valid_color(value)) {
+            palette.colors[i] = value;
+        }
+    }
+    return palette_readable(palette) ? palette : default_palette();
+}
+
+std::uint64_t stable_hash(std::string_view value, std::string_view salt = {}) noexcept {
+    std::uint64_t hash = 1469598103934665603ULL;
+    const auto add = [&hash](std::string_view input) {
+        for (unsigned char ch : input) {
+            hash ^= ch;
+            hash *= 1099511628211ULL;
+        }
+    };
+    add(value);
+    add(salt);
+    hash ^= hash >> 30;
+    hash *= 0xbf58476d1ce4e5b9ULL;
+    hash ^= hash >> 27;
+    hash *= 0x94d049bb133111ebULL;
+    return hash ^ (hash >> 31);
+}
+
+bool per_seed_enabled(const ConfigVar<std::string>& option) {
+    const std::string token = std::string{"|"} + option.getName() + "|";
+    return getSettings().cosmetics.perSeedRandomizedColors.getValueForSave().find(token) !=
+           std::string::npos;
+}
+
+void set_per_seed_enabled(ConfigVar<std::string>& option, bool enabled) {
+    auto selections = getSettings().cosmetics.perSeedRandomizedColors.getValueForSave();
+    const std::string token = std::string{"|"} + option.getName() + "|";
+    const auto position = selections.find(token);
+    if (enabled && position == std::string::npos) {
+        selections += token;
+    } else if (!enabled && position != std::string::npos) {
+        selections.erase(position, token.size());
+    }
+    getSettings().cosmetics.perSeedRandomizedColors.setValue(std::move(selections));
+}
+
+std::uint8_t selected_seed_mask() {
+    if (getSettings().cosmetics.randomizeAllColorsPerSeed.getValue()) {
+        return kAllRoles;
+    }
+    std::uint8_t mask = 0;
+    const auto vars = color_vars();
+    for (std::size_t i = 0; i < vars.size(); ++i) {
+        if (per_seed_enabled(*vars[i])) {
+            mask |= static_cast<std::uint8_t>(1u << i);
+        }
+    }
+    return mask;
+}
+
+MenuPalette merged_safe_palette(std::uint64_t value, std::uint8_t mask) {
+    const MenuPalette base = saved_palette();
+    for (std::size_t attempt = 0; attempt < kSafePalettes.size(); ++attempt) {
+        const MenuPalette source = palette_at(static_cast<std::size_t>(value) + attempt);
+        MenuPalette candidate = base;
+        for (std::size_t role = 0; role < kRoleCount; ++role) {
+            if ((mask & (1u << role)) != 0) {
+                candidate.colors[role] = source.colors[role];
+            }
+        }
+        if (palette_readable(candidate)) {
+            return candidate;
+        }
+    }
+    return default_palette();
+}
+
+void set_runtime_color(std::size_t role, const std::string& value) {
+    auto& state = runtime_state();
+    auto* option = color_vars()[role];
+    if (!state.ownedOverrides[role] || option->getValue() != value) {
+        option->setOverrideValue(value);
+    }
+    state.ownedOverrides[role] = true;
+}
+
+bool clear_runtime_color(std::size_t role) {
+    auto& state = runtime_state();
+    if (!state.ownedOverrides[role]) {
+        return false;
+    }
+    color_vars()[role]->clearOverride();
+    state.ownedOverrides[role] = false;
+    return true;
+}
+
+bool clear_runtime_colors() {
+    bool changed = false;
+    for (std::size_t role = 0; role < kRoleCount; ++role) {
+        changed = clear_runtime_color(role) || changed;
+    }
+    return changed;
+}
+
+void apply_runtime_palette(const MenuPalette& palette, std::uint8_t mask) {
+    for (std::size_t role = 0; role < kRoleCount; ++role) {
+        if ((mask & (1u << role)) != 0) {
+            set_runtime_color(role, palette.colors[role]);
+        } else {
+            clear_runtime_color(role);
+        }
+    }
+}
+
+Rgb interpolate(Rgb first, Rgb second, double amount) noexcept {
+    const auto channel = [amount](int a, int b) {
+        return static_cast<int>(std::lround(a + (b - a) * amount));
+    };
+    return {
+        channel(first.red, second.red),
+        channel(first.green, second.green),
+        channel(first.blue, second.blue),
+    };
+}
+
+std::string format_rgb(Rgb color) {
+    return fmt::format("{:02x}{:02x}{:02x}", color.red, color.green, color.blue);
+}
+
+MenuPalette rainbow_palette(std::uint64_t elapsedMilliseconds) {
+    int speed = std::clamp(getSettings().cosmetics.rainbowCycleSpeed.getValueForSave(), 0, 2);
+    const std::uint64_t segment = speed == 0 ? 4000 : speed == 2 ? 1000 : 2000;
+    const std::size_t first = (elapsedMilliseconds / segment) % kSafePalettes.size();
+    const std::size_t second = (first + 1) % kSafePalettes.size();
+    const double amount = static_cast<double>(elapsedMilliseconds % segment) /
+                          static_cast<double>(segment);
+    MenuPalette result;
+    for (std::size_t role = 0; role < kRoleCount; ++role) {
+        Rgb a;
+        Rgb b;
+        parse_rgb(kSafePalettes[first][role], a);
+        parse_rgb(kSafePalettes[second][role], b);
+        result.colors[role] = format_rgb(interpolate(a, b, amount));
+    }
+    return result;
+}
+
+bool saved_menu_rainbow() {
+    return std::ranges::any_of(color_vars(), [](const auto* option) {
+        return is_rainbow(option->getValueForSave());
+    });
+}
+
+void apply_menu_theme() noexcept {
+    try {
+        MenuPalette palette = default_palette();
+        const auto vars = color_vars();
+        for (std::size_t role = 0; role < vars.size(); ++role) {
+            const auto value = normalize_color(vars[role]->getValue());
+            if (valid_color(value)) {
+                palette.colors[role] = value;
+            }
+        }
+        if (!palette_readable(palette)) {
+            palette = default_palette();
+        }
+
+        const auto& accent = palette.colors[static_cast<std::size_t>(MenuRole::Accent)];
+        const auto& background = palette.colors[static_cast<std::size_t>(MenuRole::Background)];
+        const auto& text = palette.colors[static_cast<std::size_t>(MenuRole::Text)];
+        const auto& border = palette.colors[static_cast<std::size_t>(MenuRole::Border)];
+        const std::string windowTheme =
+            "body { color: #" + text + "; }\n"
+            "window { background-color: #" + background + "e6; border-color: #" + border +
+            "; }\n"
+            "input { background-color: #11100a; color: #" + text + "; }\n"
+            "window tab-bar { border-bottom-color: #" + border + "; }\n"
+            "window content pane:not(:last-of-type), pane.excluded-locations-pane { "
+            "border-color: #" + border + "; }\n"
+            "tab-bar tab:selected { border-bottom-color: #" + accent + "; }\n"
+            "tab-bar tab:focus-visible, tab-bar tab:hover { decorator: vertical-gradient(#" +
+            accent + "00 #" + accent + "26); }\n"
+            "tab-bar tab:active { decorator: vertical-gradient(#" + accent + "10 #" + accent +
+            "40); }\n"
+            "button:not(:disabled):hover, button:not(:disabled):focus-visible, "
+            "select-button:not(:disabled):hover, select-button:not(:disabled):focus-visible { "
+            "background-color: #" + accent + "33; box-shadow: #" + accent +
+            " 0 0 0 2dp; }\n"
+            "button:not(:disabled):selected, button:not(:disabled):active, "
+            "select-button:not(:disabled):selected, select-button:not(:disabled):active { "
+            "background-color: #" + accent + "66; box-shadow: #" + accent +
+            " 0 0 0 2dp; }\n";
+        const std::string menuBarTheme =
+            "body, popup tab-bar tab { color: #" + text + "; }\n"
+            "popup { background-color: #" + background + "cc; border-bottom-color: #" + border +
+            "; }\n"
+            "tab-bar tab:selected { border-bottom-color: #" + accent + "; }\n"
+            "tab-bar tab:focus-visible, tab-bar tab:hover { decorator: vertical-gradient(#" +
+            accent + "00 #" + accent + "26); }\n"
+            "tab-bar tab:active { decorator: vertical-gradient(#" + accent + "10 #" + accent +
+            "40); }\n";
+        register_scoped_styles(DocumentScope::Window, std::string{kThemeId}, windowTheme);
+        register_scoped_styles(DocumentScope::MenuBar, std::string{kThemeId}, menuBarTheme);
+    } catch (...) {
+        // Cosmetics can never be allowed to interrupt the UI loop.
+    }
+}
+
+void update_menu_colors_impl(bool force) noexcept {
+    try {
+        auto& settings = getSettings().cosmetics;
+        auto& state = runtime_state();
+        const bool everyLoad = settings.randomizeAllColorsEveryLoad.getValue();
+        const bool seedMode = !everyLoad && state.seedMask != 0 && !state.seedHash.empty();
+        const bool rainbow = settings.rainbowAllColors.getValue() || saved_menu_rainbow() ||
+                             (everyLoad && state.loadActive && state.loadRainbow) ||
+                             (seedMode && state.seedRainbow);
+
+        if (rainbow) {
+            constexpr std::uint64_t kFrameMilliseconds = 50;
+            const auto elapsed = static_cast<std::uint64_t>(
+                std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now().time_since_epoch())
+                    .count());
+            const std::uint64_t frame = elapsed / kFrameMilliseconds;
+            if (!force && frame == state.rainbowFrame) {
+                return;
+            }
+            state.rainbowFrame = frame;
+            apply_runtime_palette(rainbow_palette(frame * kFrameMilliseconds), kAllRoles);
+            apply_menu_theme();
+            return;
+        }
+
+        state.rainbowFrame = std::numeric_limits<std::uint64_t>::max();
+        if (everyLoad && state.loadActive) {
+            apply_runtime_palette(state.loadPalette, kAllRoles);
+        } else if (seedMode) {
+            apply_runtime_palette(state.seedPalette, state.seedMask);
+        } else {
+            clear_runtime_colors();
+        }
+        if (force) {
+            apply_menu_theme();
+        }
+    } catch (...) {
+        // Cosmetics can never be allowed to interrupt gameplay.
+    }
+}
+
+Rml::String color_label(const ConfigVar<std::string>& option) {
+    const auto value = option.getValueForSave();
+    if (value.empty()) {
+        return "Default";
+    }
+    if (is_rainbow(value)) {
+        return "Rainbow";
+    }
+    return Rml::String{"#"} + value;
+}
+
+void save_and_refresh() {
+    refresh_menu_colors();
+    config::save();
+}
+
+}  // namespace
+
+void initialize_menu_colors() noexcept {
+    apply_menu_theme();
+    update_menu_colors_impl(true);
+}
+
+void update_menu_colors() noexcept {
+    update_menu_colors_impl(false);
+}
+
+void refresh_menu_colors() noexcept {
+    auto& state = runtime_state();
+    if (!getSettings().cosmetics.randomizeAllColorsEveryLoad.getValue()) {
+        state.loadActive = false;
+        state.loadRainbow = false;
+    }
+    const std::uint8_t mask = selected_seed_mask();
+    if (!state.seedHash.empty() && mask != 0 &&
+        !getSettings().cosmetics.randomizeAllColorsEveryLoad.getValue())
+    {
+        apply_per_seed_menu_colors(state.seedHash);
+        return;
+    }
+    state.seedMask = 0;
+    state.seedRainbow = false;
+    update_menu_colors_impl(true);
+}
+
+void apply_per_seed_menu_colors(const std::string& seedHash) noexcept {
+    try {
+        auto& state = runtime_state();
+        state.seedHash = seedHash;
+        state.loadActive = false;
+        state.loadRainbow = false;
+        state.seedMask = selected_seed_mask();
+        state.seedRainbow = false;
+        if (seedHash.empty() || state.seedMask == 0 ||
+            getSettings().cosmetics.randomizeAllColorsEveryLoad.getValue())
+        {
+            update_menu_colors_impl(true);
+            return;
+        }
+        const auto value = stable_hash(seedHash, "menu-palette-v2");
+        state.seedPalette = merged_safe_palette(value, state.seedMask);
+        state.seedRainbow = stable_hash(seedHash, "menu-rainbow-v2") % 9 == 0;
+        update_menu_colors_impl(true);
+    } catch (...) {
+        // A seed must remain loadable even if a cosmetic preference is malformed.
+    }
+}
+
+void randomize_menu_colors_for_load_screen() noexcept {
+    try {
+        if (!getSettings().cosmetics.randomizeAllColorsEveryLoad.getValue()) {
+            return;
+        }
+        static std::atomic<std::uint64_t> counter{0};
+        const auto ticks = static_cast<std::uint64_t>(
+            std::chrono::steady_clock::now().time_since_epoch().count());
+        const auto value = stable_hash(fmt::format("{}:{}", ticks,
+            counter.fetch_add(1, std::memory_order_relaxed)), "menu-load-v2");
+        auto& state = runtime_state();
+        state.loadActive = true;
+        state.loadRainbow = value % 9 == 0;
+        state.loadPalette = palette_at(static_cast<std::size_t>(value));
+        update_menu_colors_impl(true);
+    } catch (...) {
+        // Area loading must not fail because of cosmetics.
+    }
+}
+
+MenuColorsWindow::MenuColorsWindow() {
+    auto& settings = getSettings().cosmetics;
+
+    add_tab("Randomize Colors", [this, &settings](Rml::Element* content) {
+        auto& left = add_child<Pane>(content, Pane::Type::Controlled);
+        auto& right = add_child<Pane>(content, Pane::Type::Uncontrolled);
+
+        const auto addMode = [&left, &right](const char* label, ConfigVar<bool>& option,
+                                 const char* description,
+                                 std::function<void(bool)> setValue) {
+            auto& button = left.add_child<BoolButton>(BoolButton::Props{
+                .key = label,
+                .getValue = [&option] { return option.getValue(); },
+                .setValue = [setValue = std::move(setValue)](bool value) {
+                    setValue(value);
+                    config::save();
+                },
+            });
+            left.register_control(button, right, [description](Pane& pane) {
+                pane.clear();
+                pane.add_text(description);
+            });
+        };
+
+        addMode("Rainbow All Menu Colors", settings.rainbowAllColors,
+            "Continuously fades the accent, background, text, and border through "
+            "contrast-safe coordinated palettes.",
+            [&settings](bool enabled) {
+                if (enabled) {
+                    settings.randomizeAllColorsPerSeed.setValue(false);
+                    settings.randomizeAllColorsEveryLoad.setValue(false);
+                }
+                settings.rainbowAllColors.setValue(enabled);
+                refresh_menu_colors();
+            });
+        addMode("Randomize Menu Colors Per Seed", settings.randomizeAllColorsPerSeed,
+            "Chooses a deterministic, readable menu palette from the active Randomizer seed.",
+            [&settings](bool enabled) {
+                if (enabled) {
+                    settings.rainbowAllColors.setValue(false);
+                    settings.randomizeAllColorsEveryLoad.setValue(false);
+                }
+                settings.randomizeAllColorsPerSeed.setValue(enabled);
+                refresh_menu_colors();
+            });
+        addMode("Randomize Menu Colors Every Load", settings.randomizeAllColorsEveryLoad,
+            "Chooses a new readable menu palette after each completed area load.",
+            [&settings](bool enabled) {
+                if (enabled) {
+                    settings.rainbowAllColors.setValue(false);
+                    settings.randomizeAllColorsPerSeed.setValue(false);
+                }
+                settings.randomizeAllColorsEveryLoad.setValue(enabled);
+                if (enabled) {
+                    randomize_menu_colors_for_load_screen();
+                } else {
+                    refresh_menu_colors();
+                }
+            });
+
+        left.register_control(left.add_select_button({
+                                  .key = "Rainbow Rotation Speed",
+                                  .getValue = [&settings] {
+                                      switch (settings.rainbowCycleSpeed.getValueForSave()) {
+                                      case 0:
+                                          return Rml::String{"Slow"};
+                                      case 2:
+                                          return Rml::String{"Fast"};
+                                      default:
+                                          return Rml::String{"Normal"};
+                                      }
+                                  },
+                              }),
+            right, [&settings](Pane& pane) {
+                pane.clear();
+                pane.add_text("Controls how quickly Rainbow moves between coordinated palettes.");
+                const auto addSpeed = [&pane, &settings](const char* label, int value) {
+                    pane.add_button(ControlledButton::Props{
+                        .text = label,
+                        .isSelected = [&settings, value] {
+                            return settings.rainbowCycleSpeed.getValueForSave() == value;
+                        },
+                    }).on_pressed([&settings, value] {
+                        settings.rainbowCycleSpeed.setValue(value);
+                        save_and_refresh();
+                    });
+                };
+                addSpeed("Slow", 0);
+                addSpeed("Normal", 1);
+                addSpeed("Fast", 2);
+            });
+    });
+
+    add_tab("Menu Colors", [this, &settings](Rml::Element* content) {
+        auto& left = add_child<Pane>(content, Pane::Type::Controlled);
+        auto& right = add_child<Pane>(content, Pane::Type::Controlled);
+        const auto vars = color_vars();
+        for (std::size_t role = 0; role < vars.size(); ++role) {
+            auto* option = vars[role];
+            const std::string label{kRoleLabels[role]};
+            left.register_control(left.add_select_button({
+                                      .key = label,
+                                      .getValue = [option] { return color_label(*option); },
+                                  }),
+                right, [option, label](Pane& pane) {
+                    pane.clear();
+                    pane.add_text("Choose a color, Rainbow, Default, or opt this role into the "
+                                  "seed-bound palette.");
+                    pane.add_child<ColorInput>(ColorInput::Props{
+                        .key = label,
+                        .getValue = [option] {
+                            auto value = normalize_color(option->getValueForSave());
+                            return is_rainbow(value) ? Rml::String{"rainbow"} : value;
+                        },
+                        .setValue = [option](Rml::String value) {
+                            value = normalize_color(std::move(value));
+                            if (!value.empty() && !valid_color(value) && !is_rainbow(value)) {
+                                return;
+                            }
+                            option->setValue(is_rainbow(value) ? "rainbow" : value);
+                            set_per_seed_enabled(*option, false);
+                            save_and_refresh();
+                        },
+                        .isDisabled = [] {
+                            const auto& colors = getSettings().cosmetics;
+                            return colors.rainbowAllColors.getValue() ||
+                                   colors.randomizeAllColorsPerSeed.getValue() ||
+                                   colors.randomizeAllColorsEveryLoad.getValue();
+                        },
+                        .isModified = [option] { return !option->getValueForSave().empty(); },
+                        .presets = {"rainbow", "c2a42d", "4da3ff", "c084fc", "5fd38d",
+                            "ff7a72", "42d8cf", "f0a34b", "f07bb4", "e0dbc8", "151610"},
+                    });
+                    pane.add_child<BoolButton>(BoolButton::Props{
+                        .key = "Randomize This Color Per Seed",
+                        .getValue = [option] {
+                            return getSettings().cosmetics.randomizeAllColorsPerSeed.getValue() ||
+                                   per_seed_enabled(*option);
+                        },
+                        .setValue = [option](bool enabled) {
+                            if (getSettings().cosmetics.randomizeAllColorsPerSeed.getValue()) {
+                                return;
+                            }
+                            set_per_seed_enabled(*option, enabled);
+                            save_and_refresh();
+                        },
+                        .isDisabled = [] {
+                            const auto& colors = getSettings().cosmetics;
+                            return colors.rainbowAllColors.getValue() ||
+                                   colors.randomizeAllColorsPerSeed.getValue() ||
+                                   colors.randomizeAllColorsEveryLoad.getValue();
+                        },
+                    });
+                });
+        }
+    });
+}
+
