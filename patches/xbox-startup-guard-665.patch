@@ -410,4 +410,32 @@ bool has_inline_sites(const void* addr, const char** outName) {
     return true;
 }
 
+const char* name_for_address(const void* addr) {
+    if (!s_state.loaded || addr == nullptr) {
+        return nullptr;
+    }
+    const auto absolute = reinterpret_cast<uintptr_t>(addr);
+    if (absolute < s_state.imageBase) {
+        return nullptr;
+    }
+    const uint64_t rva = static_cast<uint64_t>(absolute - s_state.imageBase);
+    const char* fallback = nullptr;
+    for (uint32_t i = 0; i < s_state.entryCount; ++i) {
+        const Entry& entry = s_state.entries[i];
+        if (entry.rva != rva || (entry.flags & kFlagCode) == 0 ||
+            entry.nameOff >= s_state.stringsLen)
+        {
+            continue;
+        }
+        const char* name = s_state.strings + entry.nameOff;
+        if ((entry.flags & kFlagDisplay) != 0) {
+            return name;
+        }
+        if (fallback == nullptr) {
+            fallback = name;
+        }
+    }
+    return fallback;
+}
+
 }  // namespace dusk::mods::manifest
