@@ -1,9 +1,66 @@
 #include <Windows.h>
 
+#include <cstdint>
+#include <string_view>
+#include <roapi.h>
+#include <windows.system.h>
+#include <windows.system.profile.h>
+#include <wrl/client.h>
+#include <wrl/wrappers/corewrappers.h>
+
 #define SDL_MAIN_HANDLED
 #include <SDL3/SDL.h>
 #include <SDL3/SDL_main.h>
 
+extern "C" bool dusk_query_memory_budget(
+    std::uint64_t* usage, std::uint64_t* limit, bool* xbox) noexcept {
+    if (usage == nullptr || limit == nullptr || xbox == nullptr) {
+        return false;
+    }
+    *usage = 0;
+    *limit = 0;
+    *xbox = false;
+    try {
+        // Use the SDK ABI directly: the projection's factory fallback imports
+        // LoadLibraryExW even though this probe never loads a mod library.
+        Microsoft::WRL::ComPtr<ABI::Windows::System::IMemoryManagerStatics> memory;
+        const Microsoft::WRL::Wrappers::HStringReference name(
+            RuntimeClass_Windows_System_MemoryManager);
+        if (FAILED(RoGetActivationFactory(name.Get(), IID_PPV_ARGS(memory.GetAddressOf()))) ||
+            !memory) {
+            return false;
+        }
+        UINT64 measuredUsage = 0, measuredLimit = 0;
+        if (FAILED(memory->get_AppMemoryUsage(&measuredUsage)) ||
+            FAILED(memory->get_AppMemoryUsageLimit(&measuredLimit))) {
+            return false;
+        }
+        *usage = measuredUsage;
+        *limit = measuredLimit;
+    } catch (...) {
+        return false;
+    }
+    try {
+        Microsoft::WRL::ComPtr<ABI::Windows::System::Profile::IAnalyticsInfoStatics> analytics;
+        const Microsoft::WRL::Wrappers::HStringReference name(
+            RuntimeClass_Windows_System_Profile_AnalyticsInfo);
+        if (SUCCEEDED(RoGetActivationFactory(name.Get(), IID_PPV_ARGS(analytics.GetAddressOf()))) &&
+            analytics) {
+            Microsoft::WRL::ComPtr<ABI::Windows::System::Profile::IAnalyticsVersionInfo> version;
+            Microsoft::WRL::Wrappers::HString family;
+            if (SUCCEEDED(analytics->get_VersionInfo(version.GetAddressOf())) && version &&
+                SUCCEEDED(version->get_DeviceFamily(family.GetAddressOf()))) {
+                UINT32 length = 0;
+                const auto* value = WindowsGetStringRawBuffer(family.Get(), &length);
+                *xbox = value != nullptr && std::wstring_view(value, length) == L"Windows.Xbox";
+            }
+        }
+    } catch (...) {
+        // An unknown family must never be treated as an Xbox App installation.
+    }
+    return true;
+}
+
 int bootstrap(int argc, char** argv) {
     SDL_SetHint(SDL_HINT_ENABLE_SCREEN_KEYBOARD, "true");
     SDL_SetHint(SDL_HINT_JOYSTICK_WGI, "true");
