diff --git a/src/dusk/xbox_memory_budget.hpp b/src/dusk/xbox_memory_budget.hpp
new file mode 100644
index 0000000..6a381e8
--- /dev/null
+++ b/src/dusk/xbox_memory_budget.hpp
@@ -0,0 +1,94 @@
+#pragma once
+
+#include "dusk/startup_guard.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string_view>
+
+#if defined(_UWP)
+// The Windows Store wrapper owns the WinRT calls; the portable feed never
+// guesses a memory limit or device family when the APIs are unavailable.
+extern "C" bool dusk_query_memory_budget(
+    std::uint64_t* usage, std::uint64_t* limit, bool* xbox) noexcept;
+#endif
+
+namespace dusk::xbox_memory {
+struct Budget {
+    std::uint64_t usage = 0;
+    std::uint64_t limit = 0;
+    bool xbox = false;
+    bool available = false;
+};
+
+inline Budget query() noexcept {
+    Budget result;
+#if defined(_UWP)
+    result.available = dusk_query_memory_budget(&result.usage, &result.limit, &result.xbox);
+#endif
+    return result;
+}
+
+inline bool needs_game_allowance(const Budget& budget) noexcept {
+    // Only the measured, documented Xbox App allowance blocks Play. An
+    // unavailable query, desktop UWP, and the Game allowance keep the old path.
+    return budget.available && budget.xbox && budget.limit != 0 &&
+           budget.limit <= (std::uint64_t{1} << 30);
+}
+
+inline void record(const std::filesystem::path& configPath, std::string_view operation,
+    std::string_view id, std::string_view version = {}, std::string_view error = {}) noexcept {
+#if defined(_UWP)
+    try {
+        const auto budget = query();
+        char line[768]{};
+        const auto clipped = [](std::string_view value, int maximum) {
+            return static_cast<int>(std::min(value.size(), static_cast<std::size_t>(maximum)));
+        };
+        std::snprintf(line, sizeof(line),
+            "%.*s | id=%.*s | version=%.*s | memory=%llu/%llu | xbox=%d | query=%d | error=%.*s",
+            clipped(operation, 80), operation.empty() ? "" : operation.data(),
+            clipped(id, 180), id.empty() ? "" : id.data(),
+            clipped(version, 40), version.empty() ? "" : version.data(),
+            static_cast<unsigned long long>(budget.usage),
+            static_cast<unsigned long long>(budget.limit), budget.xbox, budget.available,
+            clipped(error, 240), error.empty() ? "" : error.data());
+        for (char& ch : line) {
+            if (ch == '\r' || ch == '\n') {
+                ch = ' ';
+            }
+        }
+        startup_guard::stage(line);
+        // Keep one detailed record outside the rotating startup journal. A
+        // diagnostic write can fail without affecting the package transaction.
+        if (!configPath.empty()) {
+            std::ofstream output(configPath / "xbox-mod-load.txt", std::ios::binary | std::ios::trunc);
+            output << "build=1.4.1.739\n" << line << '\n';
+            output.flush();
+            if (!error.empty()) {
+                std::ofstream failure(configPath / "xbox-mod-load-failure.txt",
+                    std::ios::binary | std::ios::trunc);
+                failure << "build=1.4.1.739\n" << line << '\n';
+                failure.flush();
+            }
+        }
+    } catch (...) {
+    }
+#else
+    (void)configPath; (void)operation; (void)id; (void)version; (void)error;
+#endif
+}
+
+inline void record_path(const std::filesystem::path& configPath, std::string_view operation,
+    const std::filesystem::path& packagePath) noexcept {
+    try {
+        const auto utf8 = packagePath.u8string();
+        record(configPath, operation,
+            {reinterpret_cast<const char*>(utf8.data()), utf8.size()});
+    } catch (...) {
+    }
+}
+}  // namespace dusk::xbox_memory
