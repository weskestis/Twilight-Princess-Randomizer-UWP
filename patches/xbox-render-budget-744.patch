diff --git a/src/dusk/breakable_tint.hpp b/src/dusk/breakable_tint.hpp
new file mode 100644
index 0000000..1039a3d
--- /dev/null
+++ b/src/dusk/breakable_tint.hpp
@@ -0,0 +1,15 @@
+#pragma once
+#include <cstdint>
+
+namespace dusk::breakable_tint {
+// Tint the lighting-derived constant; never add light or replace its alpha.
+template<class Color>
+void apply(Color& color, bool pumpkin) noexcept {
+    const auto attenuate = [](uint8_t value, unsigned factor) {
+        return static_cast<uint8_t>((unsigned(value) * factor + 127u) / 255u);
+    };
+    color.r = attenuate(color.r, pumpkin ? 96u : 204u);
+    color.g = attenuate(color.g, pumpkin ? 192u : 154u);
+    color.b = attenuate(color.b, pumpkin ? 112u : 68u);
+}
+}
