diff --git a/mods/uwp_ports/xbox_effect_budget.hpp b/mods/uwp_ports/xbox_effect_budget.hpp
new file mode 100644
index 0000000..37b6254
--- /dev/null
+++ b/mods/uwp_ports/xbox_effect_budget.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace xbox_effect_budget {
+struct Extent { uint32_t width, height; };
+inline Extent fit(uint32_t width, uint32_t height, uint32_t maxHeight) noexcept {
+    if (height == 0 || width == 0) return {0, 0};
+    if (maxHeight == 0 || height <= maxHeight) return {width, height};
+    return {std::max(1u, uint32_t(uint64_t(width) * maxHeight / height)), maxHeight};
+}
+inline bool balanced(bool enabled, uint32_t sceneHeight) noexcept {
+    return enabled && sceneHeight > 1080;
+}
+inline void bound_ao_samples(float& slices, float& steps) noexcept {
+    slices = std::min(slices, 5.0f);
+    steps = std::min(steps, 2.0f);
+}
+}
