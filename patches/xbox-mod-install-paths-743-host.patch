diff --git a/src/dusk/mods/install_paths.hpp b/src/dusk/mods/install_paths.hpp
new file mode 100644
--- /dev/null
+++ b/src/dusk/mods/install_paths.hpp
@@ -0,0 +1,36 @@
+#pragma once
+#include <filesystem>
+#include <system_error>
+
+namespace dusk::mods::install_paths {
+// Xbox permits access to LocalState descendants, but canonicalization can try
+// to inspect inaccessible volume ancestors. Only the app-owned absolute paths
+// used by the installer take this route; reject links rather than resolving them.
+inline std::filesystem::path resolve(const std::filesystem::path& value,
+                                     std::error_code& error) {
+#if defined(_UWP)
+    error.clear();
+    if (!value.is_absolute()) {
+        error=std::make_error_code(std::errc::invalid_argument); return {};
+    }
+    const auto path=value.lexically_normal();
+    const auto status=std::filesystem::symlink_status(path,error);
+    if (error) return {};
+    if (std::filesystem::is_symlink(status)) {
+        error=std::make_error_code(std::errc::too_many_symbolic_link_levels); return {};
+    }
+    if (!std::filesystem::exists(status)) {
+        error=std::make_error_code(std::errc::no_such_file_or_directory); return {};
+    }
+    return path;
+#else
+    return std::filesystem::weakly_canonical(value,error);
+#endif
+}
+
+inline bool staging_directory_valid(const std::filesystem::path& path,
+                                    std::error_code& error) {
+    const auto resolved=resolve(path,error);
+    return !error && std::filesystem::is_directory(resolved,error) && !error;
+}
+}
