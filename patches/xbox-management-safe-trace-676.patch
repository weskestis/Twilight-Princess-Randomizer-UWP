+#if defined(_UWP)
+#include <algorithm>
+#include <charconv>
+#include <string_view>
+
+namespace {
+void trace_process(std::string_view phase, const base_process_class* process) noexcept {
+    if (process == nullptr) {
+        dusk::startup_guard::stage(phase);
+        return;
+    }
+
+    char stage[128]{};
+    char* cursor = stage;
+    char* const end = stage + sizeof(stage);
+    const auto append = [&cursor, end](std::string_view value) {
+        const std::size_t available = static_cast<std::size_t>(end - cursor);
+        const std::size_t count = value.size() < available ? value.size() : available;
+        std::copy_n(value.data(), count, cursor);
+        cursor += count;
+    };
+    const auto append_number = [&cursor, end](auto value) {
+        const auto result = std::to_chars(cursor, end, value);
+        if (result.ec == std::errc{}) {
+            cursor = result.ptr;
+        }
+    };
+
+    append(phase);
+    append(":id=");
+    append_number(process->id);
+    append(":name=");
+    append_number(process->name);
+    append(":profile=");
+    append_number(process->profname);
+    dusk::startup_guard::stage(std::string_view(stage, static_cast<std::size_t>(cursor - stage)));
+}
+}  // namespace
+#endif
+
