diff --git a/src/dusk/mods/loader/loader.cpp b/src/dusk/mods/loader/loader.cpp
--- a/src/dusk/mods/loader/loader.cpp
+++ b/src/dusk/mods/loader/loader.cpp
@@ -213,6 +213,21 @@
 
     // Asset-only mods have no lifecycle beyond their overlay files.
     if (!mod.native && !mod.runtime.has_value()) {
+        // A supplied outfit/shield/model group represents alternative payloads.
+        // Select one deterministically and persist the other variants as disabled.
+        if (!mod.metadata.exclusiveGroup.empty()) {
+            for (auto& candidate : m_mods) {
+                auto& other = *candidate;
+                if (&other == &mod || other.native || other.runtime.has_value() ||
+                    other.metadata.exclusiveGroup != mod.metadata.exclusiveGroup) {
+                    continue;
+                }
+                other.cvarIsEnabled->setValue(false);
+                if (other.active) {
+                    deactivate_mod(other);
+                }
+            }
+        }
         mod.enabledApplied = true;
         return true;
     }
