diff --git a/src/dusk/mods/uwp_ports.hpp b/src/dusk/mods/uwp_ports.hpp
new file mode 100644
--- /dev/null
+++ b/src/dusk/mods/uwp_ports.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <string_view>
+
+namespace dusk::mods::uwp_ports {
+inline constexpr std::string_view ControllerId = "org.dusklight.tp_classic_buttons";
+inline constexpr std::string_view ControllerVersion = "1.3.2";
+inline constexpr std::string_view LuauId = "dev.twilitrealm.luau";
+inline constexpr std::string_view LuauVersion = "1.0.0";
+
+constexpr bool available(std::string_view id, std::string_view version) noexcept {
+    return (id == ControllerId && version == ControllerVersion) ||
+           (id == LuauId && version == LuauVersion);
+}
+
+constexpr bool enabled_by_default(std::string_view id, bool fromSignedPackage = true) noexcept {
+    // ConfigVar preserves any existing saved preference. New optional packages
+    // start disabled; the runtime provider is inert until a script is enabled.
+    return id == "dev.twilitrealm.randomizer" || id == "dev.twilitrealm.cosmetics" ||
+           id == LuauId || (!fromSignedPackage && id != ControllerId);
+}
+}  // namespace dusk::mods::uwp_ports
