+#if defined(_UWP)
+    // The built-in Randomizer has completed initialization when this function runs. Xbox testing
+    // isolated the remaining pre-frame crash to the asset lifecycle batch (overlay, texture, and
+    // audio replacement synchronization). Keep those optional asset services quarantined until
+    // they can be reintroduced individually after the core game and Randomizer are stable.
+    startup_guard::stage("modules.lifecycle-quarantined");
+    DuskLog.warn("Xbox UWP: mod asset lifecycle synchronization is quarantined for startup safety");
+    return;
+#else
     for (const auto* module : s_modules) {
         if (module->lifecycleApplied != nullptr) {
             startup_guard::stage(fmt::format("module.lifecycle:{}", module->id));
             module->lifecycleApplied();
             startup_guard::stage(fmt::format("module.lifecycle-ready:{}", module->id));
         }
     }
+#endif
 }
 
