+
+#if defined(_UWP)
+// Build the same standard GCI payload as mDoMemCdRWm_Store, using its real
+// banner/icon construction, quest bytes and sector checksum implementation.
+void mDoMemCdRWm_BuildXboxGci(const u8* data, std::vector<u8>& packet) {
+    packet.assign(64 + CARD_FILE_SIZE, 0);
+    const auto& disc = dusk::version::getDiskID();
+    std::memcpy(packet.data(), disc.gameName, 4);
+    std::memcpy(packet.data()+4, disc.company, 2);
+    packet[7] = 5; // C8 banner and bounce icon animation.
+    std::memcpy(packet.data()+8, "gczelda2", 8);
+    packet[48] = 1; packet[49] = 0x55; // Five C8 icons.
+    packet[50] = 1; packet[51] = 0x55; // Five fast animation frames.
+    packet[52] = 4; packet[54] = 0xff; packet[55] = 0xff;
+    packet[56] = 0; packet[57] = 4; // Four 8192-byte blocks.
+    packet[62] = 0x24; // Comment at 0x2400 in the payload.
+    mDoMemCdRWm_BuildHeader(reinterpret_cast<mDoMemCdRWm_HeaderData*>(packet.data()+64));
+    alignas(data_s) std::array<u8, SECTOR_SIZE> sector{};
+    auto* saves = reinterpret_cast<data_s*>(sector.data());
+    saves->data_version = SAVEDATA_VERSION;
+    std::memcpy(saves->data, data, SAVEFILE_SIZE);
+    saves->checksum = mDoMemCdRWm_CalcCheckSum(saves, sizeof(data_s)-4);
+    std::memcpy(packet.data()+64+0x4000, sector.data(), sector.size());
+    std::memcpy(packet.data()+64+0x6000, sector.data(), sector.size());
+}
+#endif
