+namespace randomizer {
+// Physical byte items and the exact supported logical Soul range are encodable.
+// Validate before narrowing: a malformed large integer must not wrap into a Soul.
+constexpr bool is_runtime_item_id(const int itemId) noexcept {
+    return (itemId >= 0 && itemId <= 0xFE) ||
+        (itemId >= enemy_souls::kFirstEnemySoulId &&
+         itemId <= enemy_souls::kLastEnemySoulId);
