+void VerifySoulPlacementSpace(randomizer::Randomizer& r, const std::string_view testName)
+{
+    if (!testName.starts_with("souls every check ")) return;
+    constexpr std::array metadataNames{
+        "Breakable", "Expanded Shop", "Poe", "Bug Reward", "Sky Character",
+        "Golden Wolf", "Name Lookup",
+    };
+    constexpr std::array bossNames{
+        "Diababa Soul", "Fyrus Soul", "Morpheel Soul", "Stallord Soul",
+        "Blizzeta Soul", "Armogohma Soul", "Argorok Soul", "Zant Soul",
+    };
+    std::array<std::size_t, metadataNames.size()> counts{};
+    for (const auto& world : r.GetWorlds())
+    {
+        for (auto* location : world->GetAllLocations(true))
+        {
+            if (!location->IsProgression() || location->HasKnownVanillaItem()) continue;
+            const auto& metadata = location->GetMetadata();
+            if (!metadata.IsMap()) continue;
+            for (std::size_t i = 0; i < metadataNames.size(); ++i)
+            {
+                if (!metadata[metadataNames[i]]) continue;
+                ++counts[i];
+                for (const auto& definition : randomizer::enemy_souls::kDefinitions)
+                {
+                    if (location->GetForbiddenItems().contains(world->GetItem(definition.itemId)))
+                        throw std::runtime_error("Enemy Soul is category-restricted at " + location->GetName());
+                }
+                for (const auto* name : bossNames)
+                {
+                    if (location->GetForbiddenItems().contains(world->GetItem(name)))
+                        throw std::runtime_error("Boss Soul is category-restricted at " + location->GetName());
+                }
+            }
+        }
+    }
+    for (std::size_t i = 0; i < metadataNames.size(); ++i)
+    {
+        if (counts[i] == 0)
+            throw std::runtime_error(std::string("Soul placement certification has no active ") + metadataNames[i] + " check");
+    }
+    std::cout << "PASS: Enemy and Boss Souls allowed in all seven extended reward categories" << std::endl;
 }
 
 } // namespace
