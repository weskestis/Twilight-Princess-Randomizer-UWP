+bool is_soul_pickup_message(std::uint32_t messageId) noexcept {
+    return (messageId >= BOSS_SOUL_MESSAGE_BASE &&
+            messageId < BOSS_SOUL_MESSAGE_BASE + BOSS_SOUL_MESSAGE_COUNT) ||
+           (messageId >= ENEMY_SOUL_MESSAGE_BASE &&
+            messageId < ENEMY_SOUL_MESSAGE_BASE + ENEMY_SOUL_MESSAGE_COUNT);
+}
+
+ModResult register_soul_pickup_messages(const RandomizerContext&) {
+    constexpr std::array<const char*, BOSS_SOUL_MESSAGE_COUNT> bossNames{
+        "Diababa", "Fyrus", "Morpheel", "Stallord", "Blizzeta", "Armogohma", "Argorok", "Zant"};
+    constexpr std::array<MessageLanguage, 6> languages{
+        MESSAGE_LANGUAGE_ENGLISH, MESSAGE_LANGUAGE_GERMAN, MESSAGE_LANGUAGE_FRENCH,
+        MESSAGE_LANGUAGE_SPANISH, MESSAGE_LANGUAGE_ITALIAN, MESSAGE_LANGUAGE_JAPANESE};
+    const auto style = mods::flow::MessageStyle{}
+        .box_kind(MESSAGE_BOX_ITEM_GET).draw_type(MESSAGE_DRAW_INSTANT)
+        .box_position(MESSAGE_POSITION_MIDDLE).speaker(0x24).trailing_data(0x0400);
+    for (std::size_t index = 0; index < BOSS_SOUL_MESSAGE_COUNT + ENEMY_SOUL_MESSAGE_COUNT; ++index) {
+        const bool boss = index < BOSS_SOUL_MESSAGE_COUNT;
+        const std::size_t catalogIndex = boss ? index : index - BOSS_SOUL_MESSAGE_COUNT;
+        const std::uint32_t sourceId = boss ? BOSS_SOUL_MESSAGE_BASE + catalogIndex
+                                           : ENEMY_SOUL_MESSAGE_BASE + catalogIndex;
+        const std::string name = boss ? bossNames[catalogIndex]
+            : std::string(enemy_souls::kDefinitions[catalogIndex].enemy);
+        const std::string text = "You found the Soul of " + name +
+            "!\nThey are now unlocked in Hyrule.";
+        std::vector<mods::flow::MessageVariant> variants;
+        for (const auto language : languages) {
+            // Pickup wording comes from the current build, including when an
+            // older seed still stores the previous synthetic group-9 text.
+            variants.emplace_back(language, style.data(), encoded_text(text));
+        }
+        // Seed group 9 is synthetic. Register real entries in common group 0,
+        // whose resource is available in shops, chests and field pickups.
+        auto message = mods::flow::register_message(0, variants);
+        if (!message) {
+            s_lastActivationError = "Soul pickup message registration failed (748)";
+            return message.result();
+        }
+        s_soulPickupMessages.emplace(sourceId, message.id());
+        s_messages.push_back(std::move(message));
+    }
+    mods::log::info("Registered Soul pickup messages (748)");
+    return MOD_OK;
+}
