+#if defined(_UWP)
+template <typename Options>
+void open_platform(void (*open)(Options, Callback), Options options, Callback callback) {
+    struct Once {
+        std::atomic_bool finished = false;
+        Callback callback;
+    };
+    auto state = std::make_shared<Once>();
+    state->callback = std::move(callback);
+    Callback finish = [state](Result result) {
+        if (!state->finished.exchange(true, std::memory_order_acq_rel)) {
+            complete(std::move(state->callback), std::move(result));
+        }
+    };
+    try {
+        open(std::move(options), finish);
+    } catch (const std::exception& exception) {
+        finish({.status = Status::Failed, .message = exception.what()});
+    } catch (...) {
+        finish({.status = Status::Failed, .message = "Unable to open the Xbox file browser"});
+    }
+}
+#endif
