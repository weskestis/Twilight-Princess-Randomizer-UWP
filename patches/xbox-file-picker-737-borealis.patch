+
+void pump_completions() {
+    if (!SDL_IsMainThread()) {
+        return;
+    }
+    std::deque<std::unique_ptr<detail::CompletionState>> pending;
+    {
+        std::lock_guard lock(detail::g_completionMutex);
+        pending.swap(detail::g_pendingCompletions);
+    }
+    for (auto& state : pending) {
+        detail::invoke_completion(state.release());
+    }
+}
+#endif
+
 bool busy() noexcept {
